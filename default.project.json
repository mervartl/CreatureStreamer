{
  "name": "CreatureStreamer",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Remotes": {
        "$path": "src/shared/Remotes"
      },
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "StarterGui": {
      "$path": "src/gui"
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [0.388, 0.784, 0.388],
          "Locked": true,
          "Position": [0, -10, 0],
          "Size": [512, 20, 512]
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Position": [0, 1, 0],
          "Size": [6, 1, 6]
        }
      },
      "HatchStation": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Position": [15, 2, 0],
          "Size": [6, 4, 6],
          "Color": [0.9, 0.7, 0.2],
          "Shape": "Ball"
        },
        "ClickDetector": {
          "$className": "ClickDetector",
          "$properties": {
            "MaxActivationDistance": 16
          }
        }
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0, 0, 0],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}