--------------------------------------------------------------------------------
-- PASSIVE INCOME ("Viewers")
--------------------------------------------------------------------------------
-- Seconds between each income tick
Config.INCOME_TICK_SECONDS = 1

function Config.getCumulativeMergeCost(tier: number): number
	return Config.HATCH_COST * (2 ^ tier)
end

-- Viewers per minute generated by a worker at each tier.
-- Dynamically calculated based on target payback windows.
Config.INCOME_PER_TIER = {}
for tier = 0, Config.TIER_MAX do
	local cumulativeCost = Config.getCumulativeMergeCost(tier)
	local targetPaybackMinutes = 20

	if tier <= 4 then
		targetPaybackMinutes = 10 + (tier / 4) * 10
	elseif tier <= 9 then
		targetPaybackMinutes = 40 + ((tier - 5) / 4) * 20
	elseif tier <= 14 then
		targetPaybackMinutes = 80 + ((tier - 10) / 4) * 40
	else
		targetPaybackMinutes = 150 + (math.min(tier - 15, 4) / 4) * 50
	end

	local rawIncome = cumulativeCost / targetPaybackMinutes
	local roundedIncome = rawIncome
	if rawIncome >= 1000 then
		roundedIncome = math.floor(rawIncome / 100 + 0.5) * 100
	elseif rawIncome >= 100 then
		roundedIncome = math.floor(rawIncome / 10 + 0.5) * 10
	elseif rawIncome >= 10 then
		roundedIncome = math.floor(rawIncome / 5 + 0.5) * 5
	else
		roundedIncome = math.max(1, math.floor(rawIncome + 0.5))
	end
	Config.INCOME_PER_TIER[tier] = roundedIncome
end

