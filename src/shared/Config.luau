local Config = {}

--------------------------------------------------------------------------------
-- HATCHING
--------------------------------------------------------------------------------
-- Cost in currency to hatch one egg
Config.HATCH_COST = 200

-- Weighted probability table for the starting tier of a freshly hatched egg.
-- Keys are tier indices; values are base (un-luck-adjusted) weights.
-- These do NOT need to sum to 1 — they are normalized at roll time.
Config.HATCH_WEIGHTS = {
	[0] = 65, -- Common L1
	[1] = 15, -- Common L2
	[2] = 10, -- Common L3
	[3] = 5, -- Common L4
	[4] = 3, -- Common L5
	[5] = 2, -- Rare L1
}

-- Base Max Tier for hatching before ceiling upgrades
Config.BASE_MAX_HATCH_TIER = 5
-- The decay multiplier for hatch weights of newly unlocked tiers
Config.CEILING_TIER_WEIGHT_DECAY = 0.3
-- Hard floor on number of tiers in the active pool
Config.MIN_TABLE_SIZE = 4
-- Minimum displayed probability for the most recently unlocked ceiling tier (0.2%)
Config.MIN_VISIBLE_PROBABILITY = 0.002

-- How strongly Luck shifts hatch weights toward higher tiers.
-- effective_weight[tier] = base_weight * (1 + luck * LUCK_TIER_MULTIPLIER * tier)
Config.LUCK_TIER_MULTIPLIER = 0.5

--------------------------------------------------------------------------------
-- MERGING
--------------------------------------------------------------------------------
-- Number of identical-tier eggs consumed per merge (always 2)
Config.MERGE_INPUT_COUNT = 2

--------------------------------------------------------------------------------
-- TIER SCALE
--------------------------------------------------------------------------------
-- Highest tier achievable in v1 (Legendary L5 = tier 19)
Config.TIER_MAX = 19

-- Generate weights for tiers beyond BASE_MAX_HATCH_TIER for Ceiling upgrades
for tier = Config.BASE_MAX_HATCH_TIER + 1, Config.TIER_MAX do
	Config.HATCH_WEIGHTS[tier] = Config.HATCH_WEIGHTS[tier - 1] * Config.CEILING_TIER_WEIGHT_DECAY
end

-- Number of levels within each rarity band
Config.LEVELS_PER_RARITY = 5

