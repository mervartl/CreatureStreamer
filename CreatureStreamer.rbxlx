      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config.luau — Single source of truth for all tunable game constants.
	Edit this file to balance the economy. No system code should hardcode
	any of these values inline.
]]

local Config = {}

--------------------------------------------------------------------------------
-- HATCHING
--------------------------------------------------------------------------------
-- Cost in currency to hatch one egg
Config.HATCH_COST = 100

-- Weighted probability table for the starting tier of a freshly hatched egg.
-- Keys are tier indices; values are base (un-luck-adjusted) weights.
-- These do NOT need to sum to 1 — they are normalized at roll time.
Config.HATCH_WEIGHTS = {
	[0] = 65, -- Common L1
	[1] = 15, -- Common L2
	[2] = 10, -- Common L3
	[3] = 5, -- Common L4
	[4] = 3, -- Common L5
	[5] = 2, -- Rare L1
}

-- How strongly Luck shifts hatch weights toward higher tiers.
-- effective_weight[tier] = base_weight * (1 + luck * LUCK_TIER_MULTIPLIER * tier)
Config.LUCK_TIER_MULTIPLIER = 0.5

--------------------------------------------------------------------------------
-- MERGING
--------------------------------------------------------------------------------
-- Number of identical-tier eggs consumed per merge (always 2)
Config.MERGE_INPUT_COUNT = 2

--------------------------------------------------------------------------------
-- TIER SCALE
--------------------------------------------------------------------------------
-- Highest tier achievable in v1 (Legendary L5 = tier 19)
Config.TIER_MAX = 19

-- Number of levels within each rarity band
Config.LEVELS_PER_RARITY = 5

-- Rarity bands (display mapping is in TierData.luau)
Config.RARITY_NAMES = { "Common", "Rare", "Epic", "Legendary" }

--------------------------------------------------------------------------------
-- EGG INVENTORY (mergeable pool)
--------------------------------------------------------------------------------
Config.EGG_SLOTS_INITIAL = 10
Config.EGG_SLOTS_MAX = 25
Config.EGG_SLOT_BASE_COST = 200
Config.EGG_SLOT_COST_SCALE = 1.5 -- each additional slot costs BASE * SCALE^n

--------------------------------------------------------------------------------
-- JOB SLOTS (active workers)
--------------------------------------------------------------------------------
Config.JOB_SLOTS_INITIAL = 2
Config.JOB_SLOTS_MAX = 6
Config.JOB_SLOT_BASE_COST = 500
Config.JOB_SLOT_COST_SCALE = 2.0

--------------------------------------------------------------------------------
-- PASSIVE INCOME ("Viewers")
--------------------------------------------------------------------------------
-- Seconds between each income tick
Config.INCOME_TICK_SECONDS = 60

-- Target payback windows per rarity band (minutes).
-- income(tier) = cumulative_merge_cost(tier) / payback_minutes
-- This keeps the economy self-consistent: if HATCH_COST changes, income
-- scales automatically. Tune these to control how "fast" each band feels.
Config.TARGET_PAYBACK_MINUTES = {
	Common    = 8,   -- tiers 0–4:  fast feedback for new players
	Rare      = 20,  -- tiers 5–9:  moderate investment, satisfying returns
	Epic      = 38,  -- tiers 10–14: long-term goal, respectable payback
	Legendary = 52,  -- tiers 15–19: status hold, not meant to break even fast
}

-- Computed income table: income_per_min = cumulative_cost / payback_minutes
-- cumulative_cost(tier) = 2^tier * HATCH_COST (worst-case all-from-T0 path)
Config.INCOME_PER_TIER = {}
do
	local paybackByBand = {
		Config.TARGET_PAYBACK_MINUTES.Common,    -- index 1 → tiers 0–4
		Config.TARGET_PAYBACK_MINUTES.Rare,      -- index 2 → tiers 5–9
		Config.TARGET_PAYBACK_MINUTES.Epic,      -- index 3 → tiers 10–14
		Config.TARGET_PAYBACK_MINUTES.Legendary, -- index 4 → tiers 15–19
	}

	for tier = 0, Config.TIER_MAX do
		local cumulativeCost = (2 ^ tier) * Config.HATCH_COST
		local bandIndex = math.floor(tier / Config.LEVELS_PER_RARITY) + 1
		local payback = paybackByBand[bandIndex] or paybackByBand[#paybackByBand]
		Config.INCOME_PER_TIER[tier] = math.max(1, math.floor(cumulativeCost / payback))
	end
end

--------------------------------------------------------------------------------
-- SELL VALUES
--------------------------------------------------------------------------------
-- Direct egg sell (no hatch). Intentionally low — selling is a release valve.
Config.SELL_EGG_VALUE_PER_TIER = {
	[0] = 10,
	[1] = 15,
	[2] = 25,
	[3] = 40,
	[4] = 60,
	[5] = 90,
	[6] = 130,
	[7] = 180,
	[8] = 250,
	[9] = 350,
	[10] = 500,
	[11] = 700,
	[12] = 1000,
	[13] = 1400,
	[14] = 2000,
	[15] = 3000,
	[16] = 4500,
	[17] = 6500,
	[18] = 9000,
	[19] = 12000,
}

-- Worker sell value — noticeably lower than cumulative egg investment to reach
-- that tier. This is a liquidity escape hatch, not a competitive strategy.
Config.SELL_WORKER_VALUE_PER_TIER = {
	[0] = 5,
	[1] = 8,
	[2] = 12,
	[3] = 20,
	[4] = 30,
	[5] = 45,
	[6] = 65,
	[7] = 90,
	[8] = 125,
	[9] = 175,
	[10] = 250,
	[11] = 350,
	[12] = 500,
	[13] = 700,
	[14] = 1000,
	[15] = 1500,
	[16] = 2250,
	[17] = 3250,
	[18] = 4500,
	[19] = 6000,
}

--------------------------------------------------------------------------------
-- CURRENCY
--------------------------------------------------------------------------------
Config.STARTING_CURRENCY = 500
Config.CURRENCY_NAME = "Viewers"

--------------------------------------------------------------------------------
-- LUCK
--------------------------------------------------------------------------------
-- Multiplier applied to base luck when the 2x Luck Game Pass is owned
Config.LUCK_PASS_MULTIPLIER = 2
Config.BASE_LUCK = 1

--------------------------------------------------------------------------------
-- SESSION REWARDS (server-authoritative timer, resets on leave)
--------------------------------------------------------------------------------
Config.SESSION_MILESTONES = {
	{
		time = 900, -- 15 minutes in seconds
		currency = 200,
		luckBoost = 0.1, -- temporary +10% luck for the session
		freeEgg = false,
		freeEggMinTier = 0,
	},
	{
		time = 1800, -- 30 minutes in seconds
		currency = 500,
		luckBoost = 0,
		freeEgg = true,
		freeEggMinTier = 2, -- guaranteed at least Common L3
	},
}

--------------------------------------------------------------------------------
-- DAILY REWARDS (day-streak system)
--------------------------------------------------------------------------------
Config.DAILY_REWARDS = {
	{ day = 1, currency = 100 },
	{ day = 2, currency = 150 },
	{ day = 3, currency = 250 },
	{ day = 4, currency = 400 },
	{ day = 5, currency = 600 },
	{ day = 6, currency = 900 },
	{ day = 7, currency = 1500 },
}

-- Whether a broken streak fully resets (true) or soft-resets to day 1 (false).
-- Test both during playtesting.
Config.DAILY_STREAK_HARD_RESET = true

--------------------------------------------------------------------------------
-- MONETIZATION — Placeholder IDs (replace with real IDs from Creator Dashboard)
--------------------------------------------------------------------------------
-- Game Pass: 2x Luck (one-time purchase, permanent)
Config.LUCK_GAMEPASS_ID = 1962385465

-- Developer Product: Viewers Pack (repeatable, instant currency)
Config.VIEWERS_PACK_PRODUCT_ID = 3710595313
Config.VIEWERS_PACK_AMOUNT = 5000

-- Developer Product: Instant Claim (skip current session timer)
Config.INSTANT_CLAIM_PRODUCT_ID = 3710595360

--------------------------------------------------------------------------------
-- DATASTORE
--------------------------------------------------------------------------------
Config.DATASTORE_NAME = "PlayerData"
Config.DATASTORE_KEY_PREFIX = "v1_"
Config.AUTOSAVE_INTERVAL = 300 -- seconds between autosaves (5 minutes)
Config.DATASTORE_MAX_RETRIES = 5

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">RarityUtil</string>
          <string name="Source"><![CDATA[--[[
	RarityUtil.luau — Weighted-random helper for hatch tier rolls.
	Pure functions with no side effects. Usable on both server (rolls)
	and client (odds-disclosure display).
]]

local Config = require(script.Parent.Config)

local RarityUtil = {}

--- Apply luck bonus to the base hatch weights and return a normalized table.
--- Higher luck shifts weight toward higher tiers.
--- Formula: effective_weight[tier] = base * (1 + luck * LUCK_TIER_MULTIPLIER * tier)
--- @param luckBonus number — the player's effective luck value (≥ 1)
--- @return { [number]: number } — tier → probability (0..1), sums to 1
function RarityUtil.getEffectiveWeights(luckBonus: number): { [number]: number }
	local weights = {}
	local total = 0

	for tier, baseWeight in pairs(Config.HATCH_WEIGHTS) do
		local effective = baseWeight * (1 + (luckBonus - 1) * Config.LUCK_TIER_MULTIPLIER * tier)
		-- Clamp to avoid negative weights if config is mis-tuned
		effective = math.max(effective, 0)
		weights[tier] = effective
		total = total + effective
	end

	-- Normalize to probabilities
	if total > 0 then
		for tier, w in pairs(weights) do
			weights[tier] = w / total
		end
	end

	return weights
end

--- Roll a random starting tier for a hatched egg, respecting luck.
--- @param luckBonus number — the player's effective luck value (≥ 1)
--- @return number — the rolled tier index
function RarityUtil.rollTier(luckBonus: number): number
	local weights = RarityUtil.getEffectiveWeights(luckBonus)

	-- Build a sorted list of (tier, probability) for stable iteration
	local sorted = {}
	for tier, prob in pairs(weights) do
		table.insert(sorted, { tier = tier, prob = prob })
	end
	table.sort(sorted, function(a, b)
		return a.tier < b.tier
	end)

	-- Cumulative distribution sample
	local roll = math.random()
	local cumulative = 0
	for _, entry in ipairs(sorted) do
		cumulative = cumulative + entry.prob
		if roll <= cumulative then
			return entry.tier
		end
	end

	-- Fallback (should not happen with correct weights)
	return sorted[#sorted].tier
end

--- Roll a tier that is guaranteed to be at least `minTier`.
--- Used for session rewards that promise a minimum starting tier.
--- @param luckBonus number
--- @param minTier number
--- @return number
function RarityUtil.rollTierWithFloor(luckBonus: number, minTier: number): number
	local tier = RarityUtil.rollTier(luckBonus)
	return math.max(tier, minTier)
end

return RarityUtil
]]></string>
        </Properties>
      </Item>
