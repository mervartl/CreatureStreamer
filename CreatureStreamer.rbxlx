      <Item class="LocalScript" referent="42">
        <Properties>
          <string name="Name">CurrencyHUD</string>
          <string name="Source"><![CDATA[--[[
	CurrencyHUD.client.luau — Always-visible currency display at the top of the screen.
	Shows current Viewers count and egg/job slot counts.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local stateFolder = playerGui:WaitForChild("ClientState")
local dataChangedEvent = stateFolder:WaitForChild("DataChanged")

local mainUI = playerGui:WaitForChild("MainUI")

--------------------------------------------------------------------------------
-- Build HUD
--------------------------------------------------------------------------------

local hud = Instance.new("Frame")
hud.Name = "CurrencyHUD"
hud.Size = UDim2.new(0, 300, 0, 40)
hud.Position = UDim2.new(0.5, -150, 0, 8)
hud.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
hud.BackgroundTransparency = 0.15
hud.BorderSizePixel = 0
hud.ZIndex = 20
hud.Parent = mainUI

Instance.new("UICorner", hud).CornerRadius = UDim.new(0, 10)

local currencyIcon = Instance.new("TextLabel")
currencyIcon.Size = UDim2.new(0, 30, 1, 0)
currencyIcon.Position = UDim2.new(0, 8, 0, 0)
currencyIcon.BackgroundTransparency = 1
currencyIcon.Text = "👁"
currencyIcon.TextSize = 20
currencyIcon.ZIndex = 21
currencyIcon.Parent = hud

local currencyLabel = Instance.new("TextLabel")
currencyLabel.Name = "CurrencyLabel"
currencyLabel.Size = UDim2.new(0, 100, 1, 0)
currencyLabel.Position = UDim2.new(0, 36, 0, 0)
currencyLabel.BackgroundTransparency = 1
currencyLabel.Text = "0"
currencyLabel.TextColor3 = Color3.fromRGB(255, 220, 80)
currencyLabel.TextSize = 18
currencyLabel.Font = Enum.Font.GothamBold
currencyLabel.TextXAlignment = Enum.TextXAlignment.Left
currencyLabel.ZIndex = 21
currencyLabel.Parent = hud

local slotsInfo = Instance.new("TextLabel")
slotsInfo.Name = "SlotsInfo"
slotsInfo.Size = UDim2.new(0, 150, 1, 0)
slotsInfo.Position = UDim2.new(1, -158, 0, 0)
slotsInfo.BackgroundTransparency = 1
slotsInfo.Text = "🥚 0/10 | 📺 0/2"
slotsInfo.TextColor3 = Color3.fromRGB(180, 180, 200)
slotsInfo.TextSize = 12
slotsInfo.Font = Enum.Font.Gotham
slotsInfo.TextXAlignment = Enum.TextXAlignment.Right
slotsInfo.ZIndex = 21
slotsInfo.Parent = hud

--------------------------------------------------------------------------------
-- Update on data change
--------------------------------------------------------------------------------

dataChangedEvent.Event:Connect(function(data)
	if not data then return end

	-- Format currency with commas
	local formatted = tostring(math.floor(data.currency))
	-- Simple comma formatting
	local result = ""
	local len = #formatted
	for i = 1, len do
		if i > 1 and (len - i + 1) % 3 == 0 then
			result = result .. ","
		end
		result = result .. formatted:sub(i, i)
	end
	currencyLabel.Text = result

	slotsInfo.Text = string.format(
		"🥚 %d/%d | 📺 %d/%d",
		#data.eggs, data.eggSlotsCap,
		#data.workers, data.jobSlotsCap
	)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="43">
        <Properties>
          <string name="Name">DailyRewardPopup</string>
          <string name="Source"><![CDATA[--[[
	DailyRewardPopup.client.luau — Daily streak reward display and claim button.
	Shows on join if claimable, with streak progress visualization.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local stateFolder = playerGui:WaitForChild("ClientState")
local dataChangedEvent = stateFolder:WaitForChild("DataChanged")
local Remotes = stateFolder:WaitForChild("RemotesRef").Value

local ClaimDailyReward = Remotes:WaitForChild("ClaimDailyReward")

local mainUI = playerGui:WaitForChild("MainUI")

--------------------------------------------------------------------------------
-- Build UI
--------------------------------------------------------------------------------

local frame = Instance.new("Frame")
frame.Name = "DailyRewardFrame"
frame.Size = UDim2.new(0, 320, 0, 220)
frame.Position = UDim2.new(0.5, -160, 0.5, -110)
frame.BackgroundColor3 = Color3.fromRGB(25, 20, 35)
frame.BackgroundTransparency = 0.02
frame.BorderSizePixel = 0
frame.Visible = false  -- shown when claimable
frame.ZIndex = 15
frame.Parent = mainUI

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 32)
title.Position = UDim2.new(0, 0, 0, 8)
title.BackgroundTransparency = 1
title.Text = "🎁 Daily Reward"
title.TextColor3 = Color3.fromRGB(255, 200, 80)
title.TextSize = 18
title.Font = Enum.Font.GothamBold
title.ZIndex = 16
title.Parent = frame

local streakLabel = Instance.new("TextLabel")
streakLabel.Name = "StreakLabel"
streakLabel.Size = UDim2.new(1, -20, 0, 22)
streakLabel.Position = UDim2.new(0, 10, 0, 42)
streakLabel.BackgroundTransparency = 1
streakLabel.Text = "🔥 Streak: 0 days"
streakLabel.TextColor3 = Color3.fromRGB(255, 150, 50)
streakLabel.TextSize = 14
streakLabel.Font = Enum.Font.GothamBold
streakLabel.TextXAlignment = Enum.TextXAlignment.Left
streakLabel.ZIndex = 16
streakLabel.Parent = frame

-- Day boxes row
local daysRow = Instance.new("Frame")
daysRow.Name = "DaysRow"
daysRow.Size = UDim2.new(1, -20, 0, 60)
daysRow.Position = UDim2.new(0, 10, 0, 70)
daysRow.BackgroundTransparency = 1
daysRow.ZIndex = 16
daysRow.Parent = frame

local dayBoxes = {}
for i = 1, #Config.DAILY_REWARDS do
	local reward = Config.DAILY_REWARDS[i]

	local box = Instance.new("Frame")
	box.Size = UDim2.new(1 / #Config.DAILY_REWARDS, -4, 1, 0)
	box.Position = UDim2.new((i - 1) / #Config.DAILY_REWARDS, 2, 0, 0)
	box.BackgroundColor3 = Color3.fromRGB(40, 35, 55)
	box.BorderSizePixel = 0
	box.ZIndex = 16
	box.Parent = daysRow
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

	local dayLabel = Instance.new("TextLabel")
	dayLabel.Size = UDim2.new(1, 0, 0, 18)
	dayLabel.Position = UDim2.new(0, 0, 0, 4)
	dayLabel.BackgroundTransparency = 1
	dayLabel.Text = "D" .. i
	dayLabel.TextColor3 = Color3.fromRGB(160, 160, 180)
	dayLabel.TextSize = 10
	dayLabel.Font = Enum.Font.GothamBold
	dayLabel.ZIndex = 16
	dayLabel.Parent = box

	local amountLabel = Instance.new("TextLabel")
	amountLabel.Size = UDim2.new(1, 0, 0, 16)
	amountLabel.Position = UDim2.new(0, 0, 0, 22)
	amountLabel.BackgroundTransparency = 1
	amountLabel.Text = tostring(reward.currency)
	amountLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	amountLabel.TextSize = 10
	amountLabel.Font = Enum.Font.Gotham
	amountLabel.ZIndex = 16
	amountLabel.Parent = box

	local checkLabel = Instance.new("TextLabel")
	checkLabel.Name = "Check"
	checkLabel.Size = UDim2.new(1, 0, 0, 16)
	checkLabel.Position = UDim2.new(0, 0, 1, -18)
	checkLabel.BackgroundTransparency = 1
	checkLabel.Text = ""
	checkLabel.TextSize = 12
	checkLabel.ZIndex = 16
	checkLabel.Parent = box

	dayBoxes[i] = { frame = box, check = checkLabel }
end

-- Claim button
local claimBtn = Instance.new("TextButton")
claimBtn.Name = "ClaimButton"
claimBtn.Size = UDim2.new(0.6, 0, 0, 40)
claimBtn.Position = UDim2.new(0.2, 0, 0, 140)
claimBtn.BackgroundColor3 = Color3.fromRGB(80, 180, 80)
claimBtn.Text = "🎁 Claim Today's Reward!"
claimBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
claimBtn.TextSize = 14
claimBtn.Font = Enum.Font.GothamBold
claimBtn.AutoButtonColor = true
claimBtn.ZIndex = 16
claimBtn.Parent = frame
Instance.new("UICorner", claimBtn).CornerRadius = UDim.new(0, 8)

-- Close button
local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 28, 0, 28)
closeBtn.Position = UDim2.new(1, -34, 0, 6)
closeBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
closeBtn.Text = "✕"
closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
closeBtn.TextSize = 14
closeBtn.Font = Enum.Font.GothamBold
closeBtn.ZIndex = 17
closeBtn.Parent = frame
Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 6)

closeBtn.MouseButton1Click:Connect(function()
	frame.Visible = false
end)

--------------------------------------------------------------------------------
-- Logic
--------------------------------------------------------------------------------

local debounce = false
local hasShownThisSession = false

claimBtn.MouseButton1Click:Connect(function()
	if debounce then return end
	debounce = true

	claimBtn.Text = "Claiming..."
	ClaimDailyReward:FireServer()

	task.wait(1)
	claimBtn.Text = "✅ Claimed!"
	claimBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)

	task.wait(2)
	frame.Visible = false
	debounce = false
end)

-- Update display
local function updateDisplay(data)
	if not data then return end

	local streak = data.dailyStreak or 0
	streakLabel.Text = "🔥 Streak: " .. streak .. " days"

	-- Update day boxes
	local currentDay = (streak % #Config.DAILY_REWARDS)
	for i, dayBox in ipairs(dayBoxes) do
		if i <= currentDay then
			dayBox.frame.BackgroundColor3 = Color3.fromRGB(60, 100, 60)
			dayBox.check.Text = "✅"
		elseif i == currentDay + 1 then
			dayBox.frame.BackgroundColor3 = Color3.fromRGB(80, 80, 40)
			dayBox.check.Text = "➡️"
		else
			dayBox.frame.BackgroundColor3 = Color3.fromRGB(40, 35, 55)
			dayBox.check.Text = ""
		end
	end

	-- Check if claimable (compare date)
	local today = os.date("!%Y-%m-%d")
	local canClaim = data.lastDailyClaimDate ~= today

	if canClaim and not hasShownThisSession then
		frame.Visible = true
		hasShownThisSession = true
		claimBtn.Text = "🎁 Claim Today's Reward!"
		claimBtn.BackgroundColor3 = Color3.fromRGB(80, 180, 80)
	end
end

dataChangedEvent.Event:Connect(function(data)
	updateDisplay(data)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="44">
        <Properties>
          <string name="Name">EggInventoryScreen</string>
          <string name="Source"><![CDATA[--[[
	EggInventoryScreen.client.luau — Displays the mergeable egg pool.
	Shows a grid of eggs color-coded by tier, with merge and sell actions.
	Selected eggs get a prominent UIStroke highlight + checkmark overlay.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TierData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("TierData"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local stateFolder = playerGui:WaitForChild("ClientState")
local dataChangedEvent = stateFolder:WaitForChild("DataChanged")
local Remotes = stateFolder:WaitForChild("RemotesRef").Value

local MergeEggs = Remotes:WaitForChild("MergeEggs")
local SellEgg = Remotes:WaitForChild("SellEgg")
local AssignEggToJob = Remotes:WaitForChild("AssignEggToJob")

local mainUI = playerGui:WaitForChild("MainUI")

--------------------------------------------------------------------------------
-- Build UI
--------------------------------------------------------------------------------

local frame = Instance.new("Frame")
frame.Name = "EggInventoryFrame"
frame.Size = UDim2.new(0, 360, 0, 420)
frame.Position = UDim2.new(0.5, -180, 0.5, -210)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
frame.BackgroundTransparency = 0.05
frame.BorderSizePixel = 0
frame.Parent = mainUI

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Name = "Title"
title.Size = UDim2.new(1, 0, 0, 36)
title.Position = UDim2.new(0, 0, 0, 6)
title.BackgroundTransparency = 1
title.Text = "🥚 Egg Inventory"
title.TextColor3 = Color3.fromRGB(255, 220, 80)
title.TextSize = 18
title.Font = Enum.Font.GothamBold
title.Parent = frame

local infoLabel = Instance.new("TextLabel")
infoLabel.Name = "InfoLabel"
infoLabel.Size = UDim2.new(1, -20, 0, 20)
infoLabel.Position = UDim2.new(0, 10, 0, 40)
infoLabel.BackgroundTransparency = 1
infoLabel.Text = "Select two same-tier eggs to merge"
infoLabel.TextColor3 = Color3.fromRGB(160, 160, 180)
infoLabel.TextSize = 12
infoLabel.Font = Enum.Font.Gotham
infoLabel.TextXAlignment = Enum.TextXAlignment.Left
infoLabel.Parent = frame

-- Scrolling grid for eggs
local scrollFrame = Instance.new("ScrollingFrame")
scrollFrame.Name = "EggGrid"
scrollFrame.Size = UDim2.new(1, -20, 1, -130)
scrollFrame.Position = UDim2.new(0, 10, 0, 65)
scrollFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
scrollFrame.BackgroundTransparency = 0.5
scrollFrame.BorderSizePixel = 0
scrollFrame.ScrollBarThickness = 6
scrollFrame.ScrollBarImageColor3 = Color3.fromRGB(100, 100, 120)
scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
scrollFrame.Parent = frame

local scrollCorner = Instance.new("UICorner")
scrollCorner.CornerRadius = UDim.new(0, 8)
scrollCorner.Parent = scrollFrame

local gridLayout = Instance.new("UIGridLayout")
gridLayout.CellSize = UDim2.new(0, 60, 0, 70)
gridLayout.CellPadding = UDim2.new(0, 6, 0, 6)
gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
gridLayout.Parent = scrollFrame

local gridPadding = Instance.new("UIPadding")
gridPadding.PaddingLeft = UDim.new(0, 6)
gridPadding.PaddingTop = UDim.new(0, 6)
gridPadding.Parent = scrollFrame

-- Action buttons row
local actionRow = Instance.new("Frame")
actionRow.Name = "ActionRow"
actionRow.Size = UDim2.new(1, -20, 0, 36)
actionRow.Position = UDim2.new(0, 10, 1, -55)
actionRow.BackgroundTransparency = 1
actionRow.Parent = frame

local mergeBtn = Instance.new("TextButton")
mergeBtn.Name = "MergeButton"
mergeBtn.Size = UDim2.new(0.32, 0, 1, 0)
mergeBtn.Position = UDim2.new(0, 0, 0, 0)
mergeBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 120)
mergeBtn.Text = "🔄 Merge"
mergeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
mergeBtn.TextSize = 13
mergeBtn.Font = Enum.Font.GothamBold
mergeBtn.AutoButtonColor = true
mergeBtn.Parent = actionRow
Instance.new("UICorner", mergeBtn).CornerRadius = UDim.new(0, 6)

local sellBtn = Instance.new("TextButton")
sellBtn.Name = "SellButton"
sellBtn.Size = UDim2.new(0.32, 0, 1, 0)
sellBtn.Position = UDim2.new(0.34, 0, 0, 0)
sellBtn.BackgroundColor3 = Color3.fromRGB(180, 80, 80)
sellBtn.Text = "💰 Sell"
sellBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
sellBtn.TextSize = 13
sellBtn.Font = Enum.Font.GothamBold
sellBtn.AutoButtonColor = true
sellBtn.Parent = actionRow
Instance.new("UICorner", sellBtn).CornerRadius = UDim.new(0, 6)

local assignBtn = Instance.new("TextButton")
assignBtn.Name = "AssignButton"
assignBtn.Size = UDim2.new(0.32, 0, 1, 0)
assignBtn.Position = UDim2.new(0.68, 0, 0, 0)
assignBtn.BackgroundColor3 = Color3.fromRGB(80, 120, 180)
assignBtn.Text = "📺 Assign"
assignBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
assignBtn.TextSize = 13
assignBtn.Font = Enum.Font.GothamBold
assignBtn.AutoButtonColor = true
assignBtn.Parent = actionRow
Instance.new("UICorner", assignBtn).CornerRadius = UDim.new(0, 6)

--------------------------------------------------------------------------------
-- Selection visuals — UIStroke + checkmark overlay for clear feedback
--------------------------------------------------------------------------------

local SELECTED_STROKE_COLOR = Color3.fromRGB(255, 255, 80)
local SELECTED_STROKE_THICKNESS = 3
local SELECTED_BG_BRIGHTEN = 0.3 -- how much to lighten the background

local selectedEggs = {} -- array of egg IDs (max 2 for merge, 1 for sell/assign)
local eggButtons = {}   -- map of eggId -> { btn: TextButton, stroke: UIStroke, check: TextLabel, baseColor: Color3 }

--- Apply selected visual state to an egg button.
local function applySelectedVisual(eggId: string)
	local entry = eggButtons[eggId]
	if not entry then return end

	-- Add/show UIStroke for a bright border
	if not entry.stroke then
		local stroke = Instance.new("UIStroke")
		stroke.Color = SELECTED_STROKE_COLOR
		stroke.Thickness = SELECTED_STROKE_THICKNESS
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = entry.btn
		entry.stroke = stroke
	end
	entry.stroke.Enabled = true

	-- Add/show checkmark overlay
	if not entry.check then
		local check = Instance.new("TextLabel")
		check.Name = "CheckOverlay"
		check.Size = UDim2.new(0, 20, 0, 20)
		check.Position = UDim2.new(1, -22, 0, 2)
		check.BackgroundColor3 = Color3.fromRGB(255, 220, 40)
		check.BackgroundTransparency = 0.1
		check.Text = "✓"
		check.TextColor3 = Color3.fromRGB(30, 30, 30)
		check.TextSize = 14
		check.Font = Enum.Font.GothamBold
		check.ZIndex = 5
		check.Parent = entry.btn
		Instance.new("UICorner", check).CornerRadius = UDim.new(1, 0) -- circle
		entry.check = check
	end
	entry.check.Visible = true

	-- Brighten background
	local bc = entry.baseColor
	entry.btn.BackgroundColor3 = Color3.new(
		math.min(bc.R + SELECTED_BG_BRIGHTEN, 1),
		math.min(bc.G + SELECTED_BG_BRIGHTEN, 1),
		math.min(bc.B + SELECTED_BG_BRIGHTEN, 1)
	)
end

--- Remove selected visual state from an egg button.
local function removeSelectedVisual(eggId: string)
	local entry = eggButtons[eggId]
	if not entry then return end

	if entry.stroke then
		entry.stroke.Enabled = false
	end
	if entry.check then
		entry.check.Visible = false
	end
	-- Restore original color
	entry.btn.BackgroundColor3 = entry.baseColor
end

local function clearSelection()
	for _, id in ipairs(selectedEggs) do
		removeSelectedVisual(id)
	end
	selectedEggs = {}
	infoLabel.Text = "Select two same-tier eggs to merge"
	infoLabel.TextColor3 = Color3.fromRGB(160, 160, 180)
end

local function updateButtonStates()
	local selCount = #selectedEggs
	mergeBtn.BackgroundColor3 = if selCount == 2
		then Color3.fromRGB(80, 180, 80)
		else Color3.fromRGB(100, 100, 120)
	sellBtn.BackgroundColor3 = if selCount >= 1
		then Color3.fromRGB(180, 80, 80)
		else Color3.fromRGB(100, 100, 120)
	assignBtn.BackgroundColor3 = if selCount == 1
		then Color3.fromRGB(80, 120, 180)
		else Color3.fromRGB(100, 100, 120)

	-- Update info label with selection context
	if selCount == 0 then
		infoLabel.Text = "Select two same-tier eggs to merge"
		infoLabel.TextColor3 = Color3.fromRGB(160, 160, 180)
	elseif selCount == 1 then
		local entry = eggButtons[selectedEggs[1]]
		if entry then
			local tierInfo = TierData.get(entry.tier)
			infoLabel.Text = "Selected: " .. tierInfo.displayName .. " — pick another to merge, or sell/assign"
			infoLabel.TextColor3 = tierInfo.color
		end
	elseif selCount == 2 then
		local e1 = eggButtons[selectedEggs[1]]
		local e2 = eggButtons[selectedEggs[2]]
		if e1 and e2 then
			if e1.tier == e2.tier then
				local tierInfo = TierData.get(e1.tier)
				local nextInfo = TierData.get(e1.tier + 1)
				local nextName = nextInfo and nextInfo.displayName or ("T" .. (e1.tier + 1))
				infoLabel.Text = "✨ Ready to merge 2x " .. tierInfo.displayName .. " → " .. nextName
				infoLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
			else
				infoLabel.Text = "⚠️ Tiers don't match — select same-tier eggs"
				infoLabel.TextColor3 = Color3.fromRGB(255, 200, 80)
			end
		end
	end
end

local function toggleSelect(eggId: string)
	-- Check if already selected — deselect
	for i, id in ipairs(selectedEggs) do
		if id == eggId then
			table.remove(selectedEggs, i)
			removeSelectedVisual(eggId)
			updateButtonStates()
			return
		end
	end

	-- Add to selection (max 2) — bump oldest if full
	if #selectedEggs >= 2 then
		local oldId = table.remove(selectedEggs, 1)
		removeSelectedVisual(oldId)
	end

	table.insert(selectedEggs, eggId)
	applySelectedVisual(eggId)
	updateButtonStates()
end

--------------------------------------------------------------------------------
-- Render eggs
--------------------------------------------------------------------------------

local function renderEggs(data)
	-- Preserve current selection IDs so we can restore them after re-render
	local previousSelection = {}
	for _, id in ipairs(selectedEggs) do
		table.insert(previousSelection, id)
	end

	-- Clear existing buttons
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	eggButtons = {}
	selectedEggs = {}

	if not data or not data.eggs then
		return
	end

	-- Sort eggs by tier (descending) for better visibility
	local sorted = {}
	for _, egg in ipairs(data.eggs) do
		table.insert(sorted, egg)
	end
	table.sort(sorted, function(a, b)
		return a.tier > b.tier
	end)

	-- Build a set of current egg IDs for fast lookup
	local currentEggIds = {}
	for _, egg in ipairs(sorted) do
		currentEggIds[egg.id] = true
	end

	for i, egg in ipairs(sorted) do
		local tierInfo = TierData.get(egg.tier)

		local btn = Instance.new("TextButton")
		btn.Name = "Egg_" .. egg.id
		btn.LayoutOrder = i
		btn.BackgroundColor3 = tierInfo.color
		btn.Text = "T" .. egg.tier .. "\n" .. tierInfo.rarityName:sub(1, 3)
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.TextSize = 11
		btn.Font = Enum.Font.GothamBold
		btn.TextWrapped = true
		btn.AutoButtonColor = true
		btn.BorderSizePixel = 0
		btn.Parent = scrollFrame

		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

		eggButtons[egg.id] = {
			btn = btn,
			baseColor = tierInfo.color,
			tier = egg.tier,
			stroke = nil,
			check = nil,
		}

		btn.MouseButton1Click:Connect(function()
			toggleSelect(egg.id)
		end)
	end

	-- Restore previous selection if those eggs still exist
	for _, id in ipairs(previousSelection) do
		if currentEggIds[id] and eggButtons[id] then
			table.insert(selectedEggs, id)
			applySelectedVisual(id)
		end
	end

	-- Update canvas size
	local rows = math.ceil(#sorted / 5)
	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, rows * 76 + 12)

	updateButtonStates()
end

--------------------------------------------------------------------------------
-- Action handlers
--------------------------------------------------------------------------------

local debounce = false

mergeBtn.MouseButton1Click:Connect(function()
	if debounce or #selectedEggs < 2 then return end
	debounce = true

	infoLabel.Text = "Merging..."
	local success, result = MergeEggs:InvokeServer(selectedEggs[1], selectedEggs[2])

	if success then
		local tierInfo = TierData.get(result.tier)
		infoLabel.Text = "✨ Merged into " .. tierInfo.displayName .. "!"
		infoLabel.TextColor3 = tierInfo.color
	else
		infoLabel.Text = "❌ " .. tostring(result)
		infoLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
	end

	-- Selection is cleared by the data sync re-render
	task.wait(0.3)
	debounce = false
end)

sellBtn.MouseButton1Click:Connect(function()
	if debounce or #selectedEggs < 1 then return end
	debounce = true

	local eggId = selectedEggs[1]
	infoLabel.Text = "Selling..."
	local success, result = SellEgg:InvokeServer(eggId)

	if success then
		infoLabel.Text = "💰 Sold for " .. tostring(result) .. " Viewers!"
		infoLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
	else
		infoLabel.Text = "❌ " .. tostring(result)
		infoLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
	end

	task.wait(0.3)
	debounce = false
end)

assignBtn.MouseButton1Click:Connect(function()
	if debounce or #selectedEggs ~= 1 then return end
	debounce = true

	local eggId = selectedEggs[1]

	-- Confirmation prompt (irreversible action)
	infoLabel.Text = "⚠️ Assign is PERMANENT! Click again to confirm."
	infoLabel.TextColor3 = Color3.fromRGB(255, 200, 80)

	-- Wait for second click or timeout
	local confirmed = false
	local conn
	conn = assignBtn.MouseButton1Click:Once(function()
		confirmed = true
	end)

	task.wait(3)
	if conn then
		conn:Disconnect()
	end

	if confirmed then
		infoLabel.Text = "Assigning to job..."
		local success, result = AssignEggToJob:InvokeServer(eggId)
		if success then
			infoLabel.Text = "📺 Assigned to streaming job!"
			infoLabel.TextColor3 = Color3.fromRGB(100, 180, 255)
		else
			infoLabel.Text = "❌ " .. tostring(result)
			infoLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
		end
	else
		infoLabel.Text = "Assignment cancelled."
		infoLabel.TextColor3 = Color3.fromRGB(160, 160, 180)
	end

	task.wait(0.3)
	debounce = false
end)

-- Update when data changes
dataChangedEvent.Event:Connect(function(data)
	renderEggs(data)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="45">
        <Properties>
          <string name="Name">HatchScreen</string>
          <string name="Source"><![CDATA[--[[
	HatchScreen.client.luau — Hatch button, cost display, result feedback.
	Lives inside MainUI ScreenGui.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TierData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("TierData"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Wait for ClientState bridge from init.client.luau
local stateFolder = playerGui:WaitForChild("ClientState")
local dataChangedEvent = stateFolder:WaitForChild("DataChanged")
local Remotes = stateFolder:WaitForChild("RemotesRef").Value

local HatchEgg = Remotes:WaitForChild("HatchEgg")

-- Get the MainUI ScreenGui
local mainUI = playerGui:WaitForChild("MainUI")

--------------------------------------------------------------------------------
-- Build UI
--------------------------------------------------------------------------------

local frame = Instance.new("Frame")
frame.Name = "HatchFrame"
frame.Size = UDim2.new(0, 220, 0, 280)
frame.Position = UDim2.new(0, 20, 0.5, -140)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
frame.BackgroundTransparency = 0.1
frame.BorderSizePixel = 0
frame.Parent = mainUI

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Name = "Title"
title.Size = UDim2.new(1, 0, 0, 36)
title.Position = UDim2.new(0, 0, 0, 8)
title.BackgroundTransparency = 1
title.Text = "🥚 Hatch Egg"
title.TextColor3 = Color3.fromRGB(255, 220, 80)
title.TextSize = 20
title.Font = Enum.Font.GothamBold
title.Parent = frame

local costLabel = Instance.new("TextLabel")
costLabel.Name = "CostLabel"
costLabel.Size = UDim2.new(1, -20, 0, 24)
costLabel.Position = UDim2.new(0, 10, 0, 48)
costLabel.BackgroundTransparency = 1
costLabel.Text = "Cost: " .. Config.HATCH_COST .. " Viewers"
costLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
costLabel.TextSize = 14
costLabel.Font = Enum.Font.Gotham
costLabel.TextXAlignment = Enum.TextXAlignment.Left
costLabel.Parent = frame

local slotsLabel = Instance.new("TextLabel")
slotsLabel.Name = "SlotsLabel"
slotsLabel.Size = UDim2.new(1, -20, 0, 24)
slotsLabel.Position = UDim2.new(0, 10, 0, 72)
slotsLabel.BackgroundTransparency = 1
slotsLabel.Text = "Slots: --/--"
slotsLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
slotsLabel.TextSize = 14
slotsLabel.Font = Enum.Font.Gotham
slotsLabel.TextXAlignment = Enum.TextXAlignment.Left
slotsLabel.Parent = frame

local hatchButton = Instance.new("TextButton")
hatchButton.Name = "HatchButton"
hatchButton.Size = UDim2.new(1, -30, 0, 44)
hatchButton.Position = UDim2.new(0, 15, 0, 106)
hatchButton.BackgroundColor3 = Color3.fromRGB(80, 180, 80)
hatchButton.Text = "🐣 HATCH!"
hatchButton.TextColor3 = Color3.fromRGB(255, 255, 255)
hatchButton.TextSize = 18
hatchButton.Font = Enum.Font.GothamBold
hatchButton.AutoButtonColor = true
hatchButton.Parent = frame

local hatchCorner = Instance.new("UICorner")
hatchCorner.CornerRadius = UDim.new(0, 8)
hatchCorner.Parent = hatchButton

local resultLabel = Instance.new("TextLabel")
resultLabel.Name = "ResultLabel"
resultLabel.Size = UDim2.new(1, -20, 0, 60)
resultLabel.Position = UDim2.new(0, 10, 0, 160)
resultLabel.BackgroundTransparency = 1
resultLabel.Text = ""
resultLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
resultLabel.TextSize = 16
resultLabel.Font = Enum.Font.GothamBold
resultLabel.TextWrapped = true
resultLabel.Parent = frame

-- Odds button (opens OddsDetailsPopup)
local oddsButton = Instance.new("TextButton")
oddsButton.Name = "OddsButton"
oddsButton.Size = UDim2.new(1, -30, 0, 30)
oddsButton.Position = UDim2.new(0, 15, 1, -40)
oddsButton.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
oddsButton.Text = "📊 View Odds"
oddsButton.TextColor3 = Color3.fromRGB(160, 180, 255)
oddsButton.TextSize = 13
oddsButton.Font = Enum.Font.Gotham
oddsButton.AutoButtonColor = true
oddsButton.Parent = frame

local oddsCorner = Instance.new("UICorner")
oddsCorner.CornerRadius = UDim.new(0, 6)
oddsCorner.Parent = oddsButton

--------------------------------------------------------------------------------
-- Logic
--------------------------------------------------------------------------------

local debounce = false

hatchButton.MouseButton1Click:Connect(function()
	if debounce then return end
	debounce = true

	resultLabel.Text = "Hatching..."
	resultLabel.TextColor3 = Color3.fromRGB(200, 200, 200)

	local success, result = HatchEgg:InvokeServer()

	if success then
		local tierInfo = TierData.get(result.tier)
		resultLabel.Text = "✨ " .. tierInfo.displayName .. "!"
		resultLabel.TextColor3 = tierInfo.color
	else
		resultLabel.Text = "❌ " .. tostring(result)
		resultLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
	end

	task.wait(0.3)
	debounce = false
end)

-- Open odds popup
oddsButton.MouseButton1Click:Connect(function()
	local oddsPopup = mainUI:FindFirstChild("OddsPopupFrame")
	if oddsPopup then
		oddsPopup.Visible = not oddsPopup.Visible
	end
end)

-- Update display when data changes
dataChangedEvent.Event:Connect(function(data)
	if data then
		slotsLabel.Text = "Slots: " .. #data.eggs .. "/" .. data.eggSlotsCap
		local canAfford = data.currency >= Config.HATCH_COST
		local hasRoom = #data.eggs < data.eggSlotsCap
		hatchButton.BackgroundColor3 = if (canAfford and hasRoom)
			then Color3.fromRGB(80, 180, 80)
			else Color3.fromRGB(100, 100, 100)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="46">
        <Properties>
          <string name="Name">JobSlotsScreen</string>
          <string name="Source"><![CDATA[--[[
	JobSlotsScreen.client.luau — Active workers display with sell option.
	Shows workers earning passive income, with per-worker income info.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TierData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("TierData"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local stateFolder = playerGui:WaitForChild("ClientState")
local dataChangedEvent = stateFolder:WaitForChild("DataChanged")
local Remotes = stateFolder:WaitForChild("RemotesRef").Value

local SellWorker = Remotes:WaitForChild("SellWorker")

local mainUI = playerGui:WaitForChild("MainUI")

--------------------------------------------------------------------------------
-- Build UI
--------------------------------------------------------------------------------

local frame = Instance.new("Frame")
frame.Name = "JobSlotsFrame"
frame.Size = UDim2.new(0, 220, 0, 400)
frame.Position = UDim2.new(1, -240, 0.5, -200)
frame.BackgroundColor3 = Color3.fromRGB(25, 30, 40)
frame.BackgroundTransparency = 0.05
frame.BorderSizePixel = 0
frame.Parent = mainUI

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Name = "Title"
title.Size = UDim2.new(1, 0, 0, 36)
title.Position = UDim2.new(0, 0, 0, 6)
title.BackgroundTransparency = 1
title.Text = "📺 Streaming Jobs"
title.TextColor3 = Color3.fromRGB(100, 200, 255)
title.TextSize = 18
title.Font = Enum.Font.GothamBold
title.Parent = frame

local incomeLabel = Instance.new("TextLabel")
incomeLabel.Name = "IncomeLabel"
incomeLabel.Size = UDim2.new(1, -20, 0, 20)
incomeLabel.Position = UDim2.new(0, 10, 0, 40)
incomeLabel.BackgroundTransparency = 1
incomeLabel.Text = "Total Income: 0/min"
incomeLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
incomeLabel.TextSize = 13
incomeLabel.Font = Enum.Font.GothamBold
incomeLabel.TextXAlignment = Enum.TextXAlignment.Left
incomeLabel.Parent = frame

-- Scrolling list for workers
local scrollFrame = Instance.new("ScrollingFrame")
scrollFrame.Name = "WorkerList"
scrollFrame.Size = UDim2.new(1, -20, 1, -80)
scrollFrame.Position = UDim2.new(0, 10, 0, 65)
scrollFrame.BackgroundTransparency = 1
scrollFrame.BorderSizePixel = 0
scrollFrame.ScrollBarThickness = 5
scrollFrame.ScrollBarImageColor3 = Color3.fromRGB(100, 100, 120)
scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
scrollFrame.Parent = frame

local listLayout = Instance.new("UIListLayout")
listLayout.Padding = UDim.new(0, 6)
listLayout.SortOrder = Enum.SortOrder.LayoutOrder
listLayout.Parent = scrollFrame

--------------------------------------------------------------------------------
-- Render workers
--------------------------------------------------------------------------------

local debounce = false

local function renderWorkers(data)
	-- Clear existing
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	if not data then
		return
	end

	-- Calculate total income
	local totalIncome = 0
	for _, worker in ipairs(data.workers) do
		totalIncome = totalIncome + (Config.INCOME_PER_TIER[worker.tier] or 0)
	end
	incomeLabel.Text = "Total Income: " .. totalIncome .. "/min"

	-- Render each worker
	for i, worker in ipairs(data.workers) do
		local tierInfo = TierData.get(worker.tier)
		local income = Config.INCOME_PER_TIER[worker.tier] or 0
		local sellValue = Config.SELL_WORKER_VALUE_PER_TIER[worker.tier] or 0

		local row = Instance.new("Frame")
		row.Name = "Worker_" .. worker.id
		row.Size = UDim2.new(1, 0, 0, 56)
		row.LayoutOrder = i
		row.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
		row.BorderSizePixel = 0
		row.Parent = scrollFrame

		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

		-- Color bar on left
		local colorBar = Instance.new("Frame")
		colorBar.Size = UDim2.new(0, 6, 1, -8)
		colorBar.Position = UDim2.new(0, 4, 0, 4)
		colorBar.BackgroundColor3 = tierInfo.color
		colorBar.BorderSizePixel = 0
		colorBar.Parent = row
		Instance.new("UICorner", colorBar).CornerRadius = UDim.new(0, 3)

		-- Name
		local nameLabel = Instance.new("TextLabel")
		nameLabel.Size = UDim2.new(0.6, -16, 0, 20)
		nameLabel.Position = UDim2.new(0, 16, 0, 4)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Text = tierInfo.displayName
		nameLabel.TextColor3 = tierInfo.color
		nameLabel.TextSize = 13
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.Parent = row

		-- Income
		local incLabel = Instance.new("TextLabel")
		incLabel.Size = UDim2.new(0.6, -16, 0, 16)
		incLabel.Position = UDim2.new(0, 16, 0, 26)
		incLabel.BackgroundTransparency = 1
		incLabel.Text = "📈 " .. income .. "/min"
		incLabel.TextColor3 = Color3.fromRGB(140, 200, 140)
		incLabel.TextSize = 11
		incLabel.Font = Enum.Font.Gotham
		incLabel.TextXAlignment = Enum.TextXAlignment.Left
		incLabel.Parent = row

		-- Sell button
		local sellBtn = Instance.new("TextButton")
		sellBtn.Size = UDim2.new(0.35, 0, 0, 30)
		sellBtn.Position = UDim2.new(0.62, 0, 0.5, -15)
		sellBtn.BackgroundColor3 = Color3.fromRGB(150, 60, 60)
		sellBtn.Text = "Sell\n" .. sellValue
		sellBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		sellBtn.TextSize = 10
		sellBtn.Font = Enum.Font.GothamBold
		sellBtn.AutoButtonColor = true
		sellBtn.Parent = row
		Instance.new("UICorner", sellBtn).CornerRadius = UDim.new(0, 6)

		sellBtn.MouseButton1Click:Connect(function()
			if debounce then return end
			debounce = true

			local success, result = SellWorker:InvokeServer(worker.id)
			if success then
				-- Data will sync automatically
			end

			task.wait(0.3)
			debounce = false
		end)
	end

	-- Show empty slots
	local emptySlots = data.jobSlotsCap - #data.workers
	for j = 1, emptySlots do
		local emptyRow = Instance.new("Frame")
		emptyRow.Name = "EmptySlot_" .. j
		emptyRow.Size = UDim2.new(1, 0, 0, 56)
		emptyRow.LayoutOrder = #data.workers + j
		emptyRow.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
		emptyRow.BackgroundTransparency = 0.3
		emptyRow.BorderSizePixel = 0
		emptyRow.Parent = scrollFrame

		Instance.new("UICorner", emptyRow).CornerRadius = UDim.new(0, 8)

		local emptyLabel = Instance.new("TextLabel")
		emptyLabel.Size = UDim2.new(1, 0, 1, 0)
		emptyLabel.BackgroundTransparency = 1
		emptyLabel.Text = "Empty Slot"
		emptyLabel.TextColor3 = Color3.fromRGB(80, 80, 100)
		emptyLabel.TextSize = 13
		emptyLabel.Font = Enum.Font.Gotham
		emptyLabel.Parent = emptyRow
	end

	-- Update canvas
	local totalRows = data.jobSlotsCap
	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, totalRows * 62)
end

-- Update when data changes
dataChangedEvent.Event:Connect(function(data)
	renderWorkers(data)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="47">
        <Properties>
          <string name="Name">OddsDetailsPopup</string>
          <string name="Source"><![CDATA[--[[
	OddsDetailsPopup.client.luau — Required odds disclosure UI.
	Shows exact numerical probabilities for each hatch tier outcome,
	dynamically recalculated when the Luck pass is active.
	Roblox policy requirement for any paid random outcome.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TierData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("TierData"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local RarityUtil = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RarityUtil"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local stateFolder = playerGui:WaitForChild("ClientState")
local dataChangedEvent = stateFolder:WaitForChild("DataChanged")

local mainUI = playerGui:WaitForChild("MainUI")

--------------------------------------------------------------------------------
-- Build UI
--------------------------------------------------------------------------------

local frame = Instance.new("Frame")
frame.Name = "OddsPopupFrame"
frame.Size = UDim2.new(0, 300, 0, 340)
frame.Position = UDim2.new(0.5, -150, 0.5, -170)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
frame.BackgroundTransparency = 0.02
frame.BorderSizePixel = 0
frame.Visible = false  -- toggled from HatchScreen
frame.ZIndex = 10
frame.Parent = mainUI

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 32)
title.Position = UDim2.new(0, 0, 0, 8)
title.BackgroundTransparency = 1
title.Text = "📊 Hatch Odds Disclosure"
title.TextColor3 = Color3.fromRGB(255, 200, 80)
title.TextSize = 16
title.Font = Enum.Font.GothamBold
title.ZIndex = 11
title.Parent = frame

local luckLabel = Instance.new("TextLabel")
luckLabel.Name = "LuckLabel"
luckLabel.Size = UDim2.new(1, -20, 0, 18)
luckLabel.Position = UDim2.new(0, 10, 0, 40)
luckLabel.BackgroundTransparency = 1
luckLabel.Text = "Current Luck: 1.0x"
luckLabel.TextColor3 = Color3.fromRGB(120, 220, 120)
luckLabel.TextSize = 12
luckLabel.Font = Enum.Font.GothamBold
luckLabel.TextXAlignment = Enum.TextXAlignment.Left
luckLabel.ZIndex = 11
luckLabel.Parent = frame

local passLabel = Instance.new("TextLabel")
passLabel.Name = "PassLabel"
passLabel.Size = UDim2.new(1, -20, 0, 16)
passLabel.Position = UDim2.new(0, 10, 0, 58)
passLabel.BackgroundTransparency = 1
passLabel.Text = "🍀 2x Luck Pass: Not Owned"
passLabel.TextColor3 = Color3.fromRGB(160, 160, 180)
passLabel.TextSize = 11
passLabel.Font = Enum.Font.Gotham
passLabel.TextXAlignment = Enum.TextXAlignment.Left
passLabel.ZIndex = 11
passLabel.Parent = frame

-- Header row
local headerRow = Instance.new("Frame")
headerRow.Size = UDim2.new(1, -20, 0, 22)
headerRow.Position = UDim2.new(0, 10, 0, 82)
headerRow.BackgroundTransparency = 1
headerRow.ZIndex = 11
headerRow.Parent = frame

local headerTier = Instance.new("TextLabel")
headerTier.Size = UDim2.new(0.5, 0, 1, 0)
headerTier.BackgroundTransparency = 1
headerTier.Text = "Tier"
headerTier.TextColor3 = Color3.fromRGB(180, 180, 200)
headerTier.TextSize = 12
headerTier.Font = Enum.Font.GothamBold
headerTier.TextXAlignment = Enum.TextXAlignment.Left
headerTier.ZIndex = 11
headerTier.Parent = headerRow

local headerOdds = Instance.new("TextLabel")
headerOdds.Size = UDim2.new(0.5, 0, 1, 0)
headerOdds.Position = UDim2.new(0.5, 0, 0, 0)
headerOdds.BackgroundTransparency = 1
headerOdds.Text = "Probability"
headerOdds.TextColor3 = Color3.fromRGB(180, 180, 200)
headerOdds.TextSize = 12
headerOdds.Font = Enum.Font.GothamBold
headerOdds.TextXAlignment = Enum.TextXAlignment.Right
headerOdds.ZIndex = 11
headerOdds.Parent = headerRow

-- Scrolling list for odds rows
local scrollFrame = Instance.new("ScrollingFrame")
scrollFrame.Name = "OddsList"
scrollFrame.Size = UDim2.new(1, -20, 1, -140)
scrollFrame.Position = UDim2.new(0, 10, 0, 108)
scrollFrame.BackgroundTransparency = 1
scrollFrame.BorderSizePixel = 0
scrollFrame.ScrollBarThickness = 4
scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
scrollFrame.ZIndex = 11
scrollFrame.Parent = frame

local listLayout = Instance.new("UIListLayout")
listLayout.Padding = UDim.new(0, 2)
listLayout.SortOrder = Enum.SortOrder.LayoutOrder
listLayout.Parent = scrollFrame

-- Close button
local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 28, 0, 28)
closeBtn.Position = UDim2.new(1, -34, 0, 6)
closeBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
closeBtn.Text = "✕"
closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
closeBtn.TextSize = 14
closeBtn.Font = Enum.Font.GothamBold
closeBtn.ZIndex = 12
closeBtn.Parent = frame
Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 6)

closeBtn.MouseButton1Click:Connect(function()
	frame.Visible = false
end)

--------------------------------------------------------------------------------
-- Render odds table
--------------------------------------------------------------------------------

local function renderOdds(data)
	-- Clear existing rows
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	-- Calculate effective luck
	local luck = Config.BASE_LUCK
	if data then
		luck = data.luck or Config.BASE_LUCK
		if data.hasLuckPass then
			luck = luck * Config.LUCK_PASS_MULTIPLIER
		end
		luck = luck + (data.sessionLuckBoost or 0)

		luckLabel.Text = string.format("Current Luck: %.1fx", luck)
		passLabel.Text = data.hasLuckPass
			and "🍀 2x Luck Pass: ✅ Active"
			or "🍀 2x Luck Pass: Not Owned"
		passLabel.TextColor3 = data.hasLuckPass
			and Color3.fromRGB(100, 255, 100)
			or Color3.fromRGB(160, 160, 180)
	end

	-- Get weights with current luck
	local weights = RarityUtil.getEffectiveWeights(luck)

	-- Sort by tier ascending
	local sorted = {}
	for tier, prob in pairs(weights) do
		table.insert(sorted, { tier = tier, prob = prob })
	end
	table.sort(sorted, function(a, b)
		return a.tier < b.tier
	end)

	-- Render rows
	for i, entry in ipairs(sorted) do
		local tierInfo = TierData.get(entry.tier)
		local pctStr = string.format("%.2f%%", entry.prob * 100)

		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 24)
		row.LayoutOrder = i
		row.BackgroundColor3 = if i % 2 == 0
			then Color3.fromRGB(30, 30, 42)
			else Color3.fromRGB(25, 25, 35)
		row.BackgroundTransparency = 0.3
		row.BorderSizePixel = 0
		row.ZIndex = 11
		row.Parent = scrollFrame

		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)

		-- Tier name with color dot
		local tierLabel = Instance.new("TextLabel")
		tierLabel.Size = UDim2.new(0.55, 0, 1, 0)
		tierLabel.Position = UDim2.new(0, 4, 0, 0)
		tierLabel.BackgroundTransparency = 1
		tierLabel.Text = "● " .. tierInfo.displayName
		tierLabel.TextColor3 = tierInfo.color
		tierLabel.TextSize = 12
		tierLabel.Font = Enum.Font.GothamBold
		tierLabel.TextXAlignment = Enum.TextXAlignment.Left
		tierLabel.ZIndex = 11
		tierLabel.Parent = row

		-- Probability
		local probLabel = Instance.new("TextLabel")
		probLabel.Size = UDim2.new(0.4, 0, 1, 0)
		probLabel.Position = UDim2.new(0.58, 0, 0, 0)
		probLabel.BackgroundTransparency = 1
		probLabel.Text = pctStr
		probLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
		probLabel.TextSize = 12
		probLabel.Font = Enum.Font.Gotham
		probLabel.TextXAlignment = Enum.TextXAlignment.Right
		probLabel.ZIndex = 11
		probLabel.Parent = row
	end

	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, #sorted * 26)
end

-- Update when data changes or popup becomes visible
dataChangedEvent.Event:Connect(function(data)
	if frame.Visible then
		renderOdds(data)
	end
end)

frame:GetPropertyChangedSignal("Visible"):Connect(function()
	if frame.Visible then
		-- Re-render with latest data
		local data = nil
		-- Try to get data from the latest sync
		pcall(function()
			-- Access latest synced data via stateFolder approach
			-- The data will be passed on next dataChanged event
		end)
		renderOdds(data)
	end
end)

-- Do an initial render with default luck so the popup isn't empty if opened before first sync
renderOdds(nil)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="48">
        <Properties>
          <string name="Name">SessionRewardPopup</string>
          <string name="Source"><![CDATA[--[[
	SessionRewardPopup.client.luau — Displays session timer progress
	and claim buttons for 15/30 min milestones.
	Includes a collapse/expand toggle so players can hide it.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local stateFolder = playerGui:WaitForChild("ClientState")
local dataChangedEvent = stateFolder:WaitForChild("DataChanged")
local Remotes = stateFolder:WaitForChild("RemotesRef").Value

local ClaimSessionReward = Remotes:WaitForChild("ClaimSessionReward")

local mainUI = playerGui:WaitForChild("MainUI")

--------------------------------------------------------------------------------
-- Build UI — positioned bottom-left to avoid overlapping the Hatch panel
--------------------------------------------------------------------------------

local EXPANDED_SIZE = UDim2.new(0, 240, 0, 160)
local COLLAPSED_SIZE = UDim2.new(0, 240, 0, 34)

local frame = Instance.new("Frame")
frame.Name = "SessionRewardFrame"
frame.Size = EXPANDED_SIZE
frame.Position = UDim2.new(0, 20, 1, -180)
frame.BackgroundColor3 = Color3.fromRGB(25, 30, 40)
frame.BackgroundTransparency = 0.1
frame.BorderSizePixel = 0
frame.ClipsDescendants = true
frame.Parent = mainUI

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = frame

-- Title bar (always visible, acts as collapse header)
local titleBar = Instance.new("Frame")
titleBar.Name = "TitleBar"
titleBar.Size = UDim2.new(1, 0, 0, 34)
titleBar.BackgroundTransparency = 1
titleBar.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -40, 1, 0)
title.Position = UDim2.new(0, 10, 0, 0)
title.BackgroundTransparency = 1
title.Text = "⏰ Session Rewards"
title.TextColor3 = Color3.fromRGB(200, 180, 255)
title.TextSize = 15
title.Font = Enum.Font.GothamBold
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = titleBar

local timerLabel = Instance.new("TextLabel")
timerLabel.Name = "TimerLabel"
timerLabel.Size = UDim2.new(1, -20, 0, 18)
timerLabel.Position = UDim2.new(0, 10, 0, 34)
timerLabel.BackgroundTransparency = 1
timerLabel.Text = "Time: 0:00"
timerLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
timerLabel.TextSize = 13
timerLabel.Font = Enum.Font.Gotham
timerLabel.TextXAlignment = Enum.TextXAlignment.Left
timerLabel.Parent = frame

-- Collapse/expand toggle button
local isExpanded = true

local toggleBtn = Instance.new("TextButton")
toggleBtn.Name = "ToggleBtn"
toggleBtn.Size = UDim2.new(0, 28, 0, 22)
toggleBtn.Position = UDim2.new(1, -34, 0, 6)
toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 55, 80)
toggleBtn.Text = "▼"
toggleBtn.TextColor3 = Color3.fromRGB(180, 180, 220)
toggleBtn.TextSize = 12
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.AutoButtonColor = true
toggleBtn.Parent = frame
Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 4)

local function setExpanded(expanded)
	isExpanded = expanded
	if expanded then
		frame.Size = EXPANDED_SIZE
		frame.Position = UDim2.new(0, 20, 1, -180)
		toggleBtn.Text = "▼"
	else
		frame.Size = COLLAPSED_SIZE
		frame.Position = UDim2.new(0, 20, 1, -54)
		toggleBtn.Text = "▲"
	end
end

toggleBtn.MouseButton1Click:Connect(function()
	setExpanded(not isExpanded)
end)

-- Milestone rows
local milestoneFrames = {}

for i, milestone in ipairs(Config.SESSION_MILESTONES) do
	local row = Instance.new("Frame")
	row.Name = "Milestone_" .. i
	row.Size = UDim2.new(1, -20, 0, 38)
	row.Position = UDim2.new(0, 10, 0, 54 + (i - 1) * 44)
	row.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
	row.BorderSizePixel = 0
	row.Parent = frame
	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

	local minutes = math.floor(milestone.time / 60)
	local desc = Instance.new("TextLabel")
	desc.Size = UDim2.new(0.55, 0, 1, 0)
	desc.Position = UDim2.new(0, 8, 0, 0)
	desc.BackgroundTransparency = 1
	desc.Text = minutes .. " min: " .. milestone.currency .. "💰"
	if milestone.freeEgg then
		desc.Text = desc.Text .. " + 🥚"
	end
	if milestone.luckBoost and milestone.luckBoost > 0 then
		desc.Text = desc.Text .. " + 🍀"
	end
	desc.TextColor3 = Color3.fromRGB(200, 200, 220)
	desc.TextSize = 11
	desc.Font = Enum.Font.Gotham
	desc.TextXAlignment = Enum.TextXAlignment.Left
	desc.TextWrapped = true
	desc.Parent = row

	local claimBtn = Instance.new("TextButton")
	claimBtn.Name = "ClaimBtn"
	claimBtn.Size = UDim2.new(0.38, 0, 0, 26)
	claimBtn.Position = UDim2.new(0.58, 0, 0.5, -13)
	claimBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
	claimBtn.Text = "⏳ Wait"
	claimBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
	claimBtn.TextSize = 11
	claimBtn.Font = Enum.Font.GothamBold
	claimBtn.AutoButtonColor = true
	claimBtn.Parent = row
	Instance.new("UICorner", claimBtn).CornerRadius = UDim.new(0, 6)

	claimBtn.MouseButton1Click:Connect(function()
		ClaimSessionReward:FireServer(i)
	end)

	milestoneFrames[i] = { row = row, btn = claimBtn }
end

--------------------------------------------------------------------------------
-- Update timer and milestone states
--------------------------------------------------------------------------------

local cachedData = nil

dataChangedEvent.Event:Connect(function(data)
	cachedData = data
end)

-- Auto-expand when a milestone becomes claimable
local previouslyClaimable = {}

-- Live timer update loop
task.spawn(function()
	while true do
		task.wait(1)

		if cachedData and cachedData.sessionStartTime then
			local elapsed = os.clock() - cachedData.sessionStartTime
			local minutes = math.floor(elapsed / 60)
			local seconds = math.floor(elapsed % 60)
			timerLabel.Text = string.format("Time: %d:%02d", minutes, seconds)

			-- Update milestone buttons
			for i, milestone in ipairs(Config.SESSION_MILESTONES) do
				local mf = milestoneFrames[i]
				if mf then
					local claimed = cachedData.sessionRewardsClaimed and cachedData.sessionRewardsClaimed[i]
					if claimed then
						mf.btn.Text = "✅ Claimed"
						mf.btn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
						mf.btn.TextColor3 = Color3.fromRGB(120, 120, 120)
					elseif elapsed >= milestone.time then
						mf.btn.Text = "🎁 Claim!"
						mf.btn.BackgroundColor3 = Color3.fromRGB(80, 180, 80)
						mf.btn.TextColor3 = Color3.fromRGB(255, 255, 255)

						-- Auto-expand if this just became claimable
						if not previouslyClaimable[i] then
							previouslyClaimable[i] = true
							setExpanded(true)
						end
					else
						local remaining = milestone.time - elapsed
						local remMin = math.floor(remaining / 60)
						local remSec = math.floor(remaining % 60)
						mf.btn.Text = string.format("⏳ %d:%02d", remMin, remSec)
						mf.btn.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
						mf.btn.TextColor3 = Color3.fromRGB(180, 180, 180)
					end
				end
			end
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="49">
        <Properties>
          <string name="Name">ShopScreen</string>
          <string name="Source"><![CDATA[--[[
	ShopScreen.client.luau — Slot expansions, Game Pass, and Developer Products.
	Toggleable panel with buy buttons for each shop item.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local stateFolder = playerGui:WaitForChild("ClientState")
local dataChangedEvent = stateFolder:WaitForChild("DataChanged")
local Remotes = stateFolder:WaitForChild("RemotesRef").Value

local BuySlot = Remotes:WaitForChild("BuySlot")

local mainUI = playerGui:WaitForChild("MainUI")

--------------------------------------------------------------------------------
-- Build UI
--------------------------------------------------------------------------------

local frame = Instance.new("Frame")
frame.Name = "ShopFrame"
frame.Size = UDim2.new(0, 280, 0, 380)
frame.Position = UDim2.new(0.5, -140, 0.5, -190)
frame.BackgroundColor3 = Color3.fromRGB(30, 25, 40)
frame.BackgroundTransparency = 0.05
frame.BorderSizePixel = 0
frame.Visible = false  -- toggled by shop button
frame.Parent = mainUI

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 36)
title.Position = UDim2.new(0, 0, 0, 6)
title.BackgroundTransparency = 1
title.Text = "🛒 Shop"
title.TextColor3 = Color3.fromRGB(255, 200, 80)
title.TextSize = 20
title.Font = Enum.Font.GothamBold
title.Parent = frame

-- Close button
local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 30, 0, 30)
closeBtn.Position = UDim2.new(1, -36, 0, 6)
closeBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
closeBtn.Text = "✕"
closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
closeBtn.TextSize = 16
closeBtn.Font = Enum.Font.GothamBold
closeBtn.Parent = frame
Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 6)

closeBtn.MouseButton1Click:Connect(function()
	frame.Visible = false
end)

-- Content list
local contentFrame = Instance.new("ScrollingFrame")
contentFrame.Size = UDim2.new(1, -20, 1, -50)
contentFrame.Position = UDim2.new(0, 10, 0, 46)
contentFrame.BackgroundTransparency = 1
contentFrame.BorderSizePixel = 0
contentFrame.ScrollBarThickness = 5
contentFrame.CanvasSize = UDim2.new(0, 0, 0, 400)
contentFrame.Parent = frame

local listLayout = Instance.new("UIListLayout")
listLayout.Padding = UDim.new(0, 8)
listLayout.SortOrder = Enum.SortOrder.LayoutOrder
listLayout.Parent = contentFrame

--------------------------------------------------------------------------------
-- Helper: create a shop item row
--------------------------------------------------------------------------------

local function createShopItem(parent, order, titleText, descText, btnText, btnColor, onClick)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 66)
	row.LayoutOrder = order
	row.BackgroundColor3 = Color3.fromRGB(40, 35, 55)
	row.BorderSizePixel = 0
	row.Parent = parent
	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

	local itemTitle = Instance.new("TextLabel")
	itemTitle.Size = UDim2.new(0.6, 0, 0, 22)
	itemTitle.Position = UDim2.new(0, 10, 0, 6)
	itemTitle.BackgroundTransparency = 1
	itemTitle.Text = titleText
	itemTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
	itemTitle.TextSize = 14
	itemTitle.Font = Enum.Font.GothamBold
	itemTitle.TextXAlignment = Enum.TextXAlignment.Left
	itemTitle.Parent = row

	local desc = Instance.new("TextLabel")
	desc.Name = "Desc"
	desc.Size = UDim2.new(0.6, 0, 0, 16)
	desc.Position = UDim2.new(0, 10, 0, 28)
	desc.BackgroundTransparency = 1
	desc.Text = descText
	desc.TextColor3 = Color3.fromRGB(160, 160, 180)
	desc.TextSize = 11
	desc.Font = Enum.Font.Gotham
	desc.TextXAlignment = Enum.TextXAlignment.Left
	desc.TextWrapped = true
	desc.Parent = row

	local btn = Instance.new("TextButton")
	btn.Name = "BuyButton"
	btn.Size = UDim2.new(0.32, 0, 0, 36)
	btn.Position = UDim2.new(0.65, 0, 0.5, -18)
	btn.BackgroundColor3 = btnColor
	btn.Text = btnText
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 12
	btn.Font = Enum.Font.GothamBold
	btn.AutoButtonColor = true
	btn.Parent = row
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

	btn.MouseButton1Click:Connect(onClick)

	return row
end

--------------------------------------------------------------------------------
-- Shop items
--------------------------------------------------------------------------------

local debounce = false

-- 1. Egg Slot Expansion
local eggSlotRow = createShopItem(contentFrame, 1,
	"🥚 +1 Egg Slot",
	"Expand egg inventory",
	"Buy",
	Color3.fromRGB(80, 150, 80),
	function()
		if debounce then return end
		debounce = true
		BuySlot:InvokeServer("egg")
		task.wait(0.5)
		debounce = false
	end
)

-- 2. Job Slot Expansion
local jobSlotRow = createShopItem(contentFrame, 2,
	"📺 +1 Job Slot",
	"Expand streaming jobs",
	"Buy",
	Color3.fromRGB(80, 120, 180),
	function()
		if debounce then return end
		debounce = true
		BuySlot:InvokeServer("job")
		task.wait(0.5)
		debounce = false
	end
)

-- 3. 2x Luck Game Pass
createShopItem(contentFrame, 3,
	"🍀 2x Luck (Permanent)",
	"Doubles hatch odds for rarer eggs",
	"R$ Buy",
	Color3.fromRGB(200, 160, 40),
	function()
		if Config.LUCK_GAMEPASS_ID ~= 0 then
			MarketplaceService:PromptGamePassPurchase(player, Config.LUCK_GAMEPASS_ID)
		else
			warn("[Shop] Luck Game Pass ID not configured!")
		end
	end
)

-- 4. Viewers Pack (Dev Product)
createShopItem(contentFrame, 4,
	"💰 Viewers Pack",
	Config.VIEWERS_PACK_AMOUNT .. " Viewers instantly",
	"R$ Buy",
	Color3.fromRGB(100, 180, 60),
	function()
		if Config.VIEWERS_PACK_PRODUCT_ID ~= 0 then
			MarketplaceService:PromptProductPurchase(player, Config.VIEWERS_PACK_PRODUCT_ID)
		else
			warn("[Shop] Viewers Pack Product ID not configured!")
		end
	end
)

-- 5. Instant Claim (Dev Product)
createShopItem(contentFrame, 5,
	"⏩ Instant Claim",
	"Skip session timer, claim rewards now",
	"R$ Buy",
	Color3.fromRGB(140, 80, 200),
	function()
		if Config.INSTANT_CLAIM_PRODUCT_ID ~= 0 then
			MarketplaceService:PromptProductPurchase(player, Config.INSTANT_CLAIM_PRODUCT_ID)
		else
			warn("[Shop] Instant Claim Product ID not configured!")
		end
	end
)

--------------------------------------------------------------------------------
-- Update slot costs dynamically
--------------------------------------------------------------------------------

local function updateCosts(data)
	if not data then return end

	-- Egg slot cost
	local eggSlotsBought = data.eggSlotsCap - Config.EGG_SLOTS_INITIAL
	local eggCost = math.floor(Config.EGG_SLOT_BASE_COST * (Config.EGG_SLOT_COST_SCALE ^ eggSlotsBought))
	local eggDesc = eggSlotRow:FindFirstChild("Desc")
	local eggBtn = eggSlotRow:FindFirstChild("BuyButton")
	if eggDesc then
		eggDesc.Text = "Slots: " .. data.eggSlotsCap .. "/" .. Config.EGG_SLOTS_MAX
	end
	if eggBtn then
		if data.eggSlotsCap >= Config.EGG_SLOTS_MAX then
			eggBtn.Text = "MAX"
			eggBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
		else
			eggBtn.Text = eggCost .. " 👁"
		end
	end

	-- Job slot cost
	local jobSlotsBought = data.jobSlotsCap - Config.JOB_SLOTS_INITIAL
	local jobCost = math.floor(Config.JOB_SLOT_BASE_COST * (Config.JOB_SLOT_COST_SCALE ^ jobSlotsBought))
	local jobDesc = jobSlotRow:FindFirstChild("Desc")
	local jobBtn = jobSlotRow:FindFirstChild("BuyButton")
	if jobDesc then
		jobDesc.Text = "Slots: " .. data.jobSlotsCap .. "/" .. Config.JOB_SLOTS_MAX
	end
	if jobBtn then
		if data.jobSlotsCap >= Config.JOB_SLOTS_MAX then
			jobBtn.Text = "MAX"
			jobBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
		else
			jobBtn.Text = jobCost .. " 👁"
		end
	end
end

dataChangedEvent.Event:Connect(function(data)
	updateCosts(data)
end)

-- Toggle button (placed outside the shop frame, always visible)
local shopToggle = Instance.new("TextButton")
shopToggle.Name = "ShopToggle"
shopToggle.Size = UDim2.new(0, 60, 0, 40)
shopToggle.Position = UDim2.new(1, -70, 0, 10)
shopToggle.BackgroundColor3 = Color3.fromRGB(200, 160, 40)
shopToggle.Text = "🛒"
shopToggle.TextSize = 22
shopToggle.Font = Enum.Font.GothamBold
shopToggle.AutoButtonColor = true
shopToggle.Parent = mainUI
Instance.new("UICorner", shopToggle).CornerRadius = UDim.new(0, 8)

shopToggle.MouseButton1Click:Connect(function()
	frame.Visible = not frame.Visible
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="50">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="51">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="52">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	Client Bootstrap — init.client.luau
	Listens for SyncPlayerData events, maintains local state mirror,
	and initializes all UI screen modules.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local SyncPlayerDataRemote = Remotes:WaitForChild("SyncPlayerData")

-- Shared modules (available client-side)
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

--------------------------------------------------------------------------------
-- Client State — read-only mirror of server data
--------------------------------------------------------------------------------
local ClientState = {
	data = nil,                -- populated by SyncPlayerData
	onDataChanged = {},        -- array of callback functions
}

--- Register a callback that fires whenever player data updates.
function ClientState.onChange(callback)
	table.insert(ClientState.onDataChanged, callback)
	-- Fire immediately if data already exists
	if ClientState.data then
		task.spawn(callback, ClientState.data)
	end
end

--- Get the current data (may be nil before first sync).
function ClientState.getData()
	return ClientState.data
end

-- Listen for state updates from server
SyncPlayerDataRemote.OnClientEvent:Connect(function(newData)
	ClientState.data = newData
	for _, callback in ipairs(ClientState.onDataChanged) do
		task.spawn(callback, newData)
	end
end)

--------------------------------------------------------------------------------
-- Make ClientState available to UI modules via a ModuleScript-like pattern.
-- UI scripts require this file and get the ClientState table.
-- Since init.client.luau is a LocalScript (not a ModuleScript), we store
-- ClientState in a shared location that UI scripts can access.
--------------------------------------------------------------------------------

-- Store ClientState in an attribute-accessible location for the UI scripts
-- We use a BindableEvent approach: fire data to all listeners
local stateFolder = Instance.new("Folder")
stateFolder.Name = "ClientState"
stateFolder.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

-- Store the state table reference on the folder for direct access
local stateValue = Instance.new("ObjectValue")
stateValue.Name = "StateRef"
stateValue.Parent = stateFolder

-- Create a BindableEvent for notifying UI modules of data changes
local dataChangedEvent = Instance.new("BindableEvent")
dataChangedEvent.Name = "DataChanged"
dataChangedEvent.Parent = stateFolder

-- Forward SyncPlayerData to the BindableEvent so GUI scripts can listen
SyncPlayerDataRemote.OnClientEvent:Connect(function(newData)
	ClientState.data = newData
	dataChangedEvent:Fire(newData)
end)

-- Store Remotes reference for easy access by UI scripts
local remotesRef = Instance.new("ObjectValue")
remotesRef.Name = "RemotesRef"
remotesRef.Value = Remotes
remotesRef.Parent = stateFolder

print("[Client] Creature Streamer client initialized, waiting for server data...")
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="53">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
    <Item class="Part" referent="54">
      <Properties>
        <string name="Name">Baseplate</string>
        <bool name="Anchored">true</bool>
        <Color3uint8 name="Color3uint8">6539363</Color3uint8>
        <bool name="Locked">true</bool>
        <Vector3 name="Position">
          <X>0</X>
          <Y>-10</Y>
          <Z>0</Z>
        </Vector3>
        <Vector3 name="size">
          <X>512</X>
          <Y>20</Y>
          <Z>512</Z>
        </Vector3>
      </Properties>
    </Item>
    <Item class="Part" referent="55">
      <Properties>
        <string name="Name">HatchStation</string>
        <bool name="Anchored">true</bool>
