  <Item class="ServerScriptService" referent="26">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="27">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Server Bootstrap — init.server.luau
	Wires up all remote handlers, player lifecycle events,
	and starts background loops (passive income, autosave).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Remote references
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local HatchEggRemote = Remotes:WaitForChild("HatchEgg")
local MergeEggsRemote = Remotes:WaitForChild("MergeEggs")
local SellEggRemote = Remotes:WaitForChild("SellEgg")
local AssignEggToJobRemote = Remotes:WaitForChild("AssignEggToJob")
local SellWorkerRemote = Remotes:WaitForChild("SellWorker")
local BuySlotRemote = Remotes:WaitForChild("BuySlot")
local ClaimSessionRewardRemote = Remotes:WaitForChild("ClaimSessionReward")
local ClaimDailyRewardRemote = Remotes:WaitForChild("ClaimDailyReward")
local SyncPlayerDataRemote = Remotes:WaitForChild("SyncPlayerData")

-- System modules
local DataStoreManager = require(script.Systems.DataStoreManager)
local HatchSystem = require(script.Systems.HatchSystem)
local MergeSystem = require(script.Systems.MergeSystem)
local JobAssignmentSystem = require(script.Systems.JobAssignmentSystem)
local CurrencySystem = require(script.Systems.CurrencySystem)
local LuckSystem = require(script.Systems.LuckSystem)
local SlotSystem = require(script.Systems.SlotSystem)
local SessionRewardSystem = require(script.Systems.SessionRewardSystem)
local DailyRewardSystem = require(script.Systems.DailyRewardSystem)
local MarketplaceHandler = require(script.Systems.MarketplaceHandler)

local Config = require(ReplicatedStorage.Shared.Config)

--------------------------------------------------------------------------------
-- Helper: send updated state to client after any mutation
--------------------------------------------------------------------------------
local function syncToClient(player: Player)
	local clientData = DataStoreManager.getClientData(player)
	if clientData then
		SyncPlayerDataRemote:FireClient(player, clientData)
	end
end

--------------------------------------------------------------------------------
-- Remote handlers
--------------------------------------------------------------------------------

HatchEggRemote.OnServerInvoke = function(player)
	local success, result = HatchSystem.hatch(player)
	syncToClient(player)
	return success, result
end

MergeEggsRemote.OnServerInvoke = function(player, eggId1, eggId2)
	if type(eggId1) ~= "string" or type(eggId2) ~= "string" then
		return false, "Invalid egg IDs"
	end
	local success, result = MergeSystem.merge(player, eggId1, eggId2)
	syncToClient(player)
	return success, result
end

SellEggRemote.OnServerInvoke = function(player, eggId)
	if type(eggId) ~= "string" then
		return false, "Invalid egg ID"
	end
	local success, result = CurrencySystem.sellEgg(player, eggId)
	syncToClient(player)
	return success, result
end

AssignEggToJobRemote.OnServerInvoke = function(player, eggId)
	if type(eggId) ~= "string" then
		return false, "Invalid egg ID"
	end
	local success, result = JobAssignmentSystem.assign(player, eggId)
	syncToClient(player)
	return success, result
end

SellWorkerRemote.OnServerInvoke = function(player, workerId)
	if type(workerId) ~= "string" then
		return false, "Invalid worker ID"
	end
	local success, result = CurrencySystem.sellWorker(player, workerId)
	syncToClient(player)
	return success, result
end

BuySlotRemote.OnServerInvoke = function(player, slotType)
	if type(slotType) ~= "string" then
		return false, "Invalid slot type"
	end
	local success, result = SlotSystem.buySlot(player, slotType)
	syncToClient(player)
	return success, result
end

ClaimSessionRewardRemote.OnServerEvent:Connect(function(player, milestoneIndex)
	if type(milestoneIndex) ~= "number" then
		return
	end
	SessionRewardSystem.claim(player, milestoneIndex)
	syncToClient(player)
end)

ClaimDailyRewardRemote.OnServerEvent:Connect(function(player)
	DailyRewardSystem.claim(player)
	syncToClient(player)
end)

--------------------------------------------------------------------------------
-- Player lifecycle
--------------------------------------------------------------------------------

Players.PlayerAdded:Connect(function(player)
	-- Load data from DataStore
	local data = DataStoreManager.loadPlayerData(player)

	-- Check gamepass ownership
	LuckSystem.checkLuckPass(player)

	-- Send initial state to client
	syncToClient(player)

	-- Check daily reward eligibility and notify
	local canClaim, nextDay = DailyRewardSystem.canClaim(player)
	if canClaim then
		-- Client will see this in the synced data and show popup
		-- (eligibility is determined client-side from the synced date)
	end

	print("[Server] Player loaded:", player.Name, "| Currency:", data.currency, "| Eggs:", #data.eggs, "| Workers:", #data.workers)
end)

Players.PlayerRemoving:Connect(function(player)
	DataStoreManager.savePlayerData(player)
	DataStoreManager.clearCache(player)
	LuckSystem.clearCache(player)
end)

-- Save all on server shutdown
game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(function()
			DataStoreManager.savePlayerData(player)
		end)
	end
	-- Give saves time to complete
	task.wait(3)
end)

--------------------------------------------------------------------------------
-- Background loops
--------------------------------------------------------------------------------

-- Passive income tick loop
task.spawn(function()
	while true do
		task.wait(Config.INCOME_TICK_SECONDS)
		for _, player in ipairs(Players:GetPlayers()) do
			local income = CurrencySystem.tickPassiveIncome(player)
			if income > 0 then
				syncToClient(player)
			end
		end
	end
end)

-- Session reward eligibility check loop (every 10 seconds)
task.spawn(function()
	while true do
		task.wait(10)
		for _, player in ipairs(Players:GetPlayers()) do
			local claimable = SessionRewardSystem.getClaimableMilestones(player)
			if #claimable > 0 then
				syncToClient(player)
			end
		end
	end
end)

-- Start autosave loop
DataStoreManager.startAutosaveLoop()

-- Initialize marketplace handlers
MarketplaceHandler.init()

print("[Server] Creature Streamer server initialized successfully!")
]]></string>
      </Properties>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Systems</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">CurrencySystem</string>
            <string name="Source"><![CDATA[--[[
	CurrencySystem.luau — Handles direct sells and passive income ticks.
	All currency modifications are server-authoritative.
]]

local Config = require(game.ReplicatedStorage.Shared.Config)
local DataStoreManager = require(script.Parent.DataStoreManager)

local CurrencySystem = {}

--- Find an egg/worker in a list by ID.
local function findById(list, id: string)
	for i, item in ipairs(list) do
		if item.id == id then
			return i, item
		end
	end
	return nil, nil
end

--- Sell an egg directly from the merge pool (no hatch).
--- @param player Player
--- @param eggId string
--- @return boolean success, number|string result — currency gained or error
function CurrencySystem.sellEgg(player: Player, eggId: string)
	local data = DataStoreManager.getData(player)
	if not data then
		return false, "Data not loaded"
	end

	local idx, egg = findById(data.eggs, eggId)
	if not egg then
		return false, "Egg not found"
	end

	local value = Config.SELL_EGG_VALUE_PER_TIER[egg.tier] or 0
	table.remove(data.eggs, idx)
	data.currency = data.currency + value

	return true, value
end

--- Sell (liquidate) an active worker.
--- @param player Player
--- @param workerId string
--- @return boolean success, number|string result — currency gained or error
function CurrencySystem.sellWorker(player: Player, workerId: string)
	local data = DataStoreManager.getData(player)
	if not data then
		return false, "Data not loaded"
	end

	local idx, worker = findById(data.workers, workerId)
	if not worker then
		return false, "Worker not found"
	end

	local value = Config.SELL_WORKER_VALUE_PER_TIER[worker.tier] or 0
	table.remove(data.workers, idx)
	data.currency = data.currency + value

	return true, value
end

--- Calculate and award passive income from all active workers.
--- Called once per INCOME_TICK_SECONDS by the tick loop.
--- @param player Player
--- @return number totalIncome — currency earned this tick
function CurrencySystem.tickPassiveIncome(player: Player): number
	local data = DataStoreManager.getData(player)
	if not data then
		return 0
	end

	local totalIncome = 0
	for _, worker in ipairs(data.workers) do
		local income = Config.INCOME_PER_TIER[worker.tier] or 0
		totalIncome = totalIncome + income
	end

	data.currency = data.currency + totalIncome
	return totalIncome
end

--- Add currency directly (used by reward systems, dev products, etc.).
--- @param player Player
--- @param amount number
function CurrencySystem.addCurrency(player: Player, amount: number)
	local data = DataStoreManager.getData(player)
	if not data then
		return
	end
	data.currency = data.currency + amount
end

return CurrencySystem
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">DailyRewardSystem</string>
            <string name="Source"><![CDATA[--[[
	DailyRewardSystem.luau — Day-streak reward system.
	Checks date on join, awards escalating rewards for consecutive logins.
]]

local Config = require(game.ReplicatedStorage.Shared.Config)
local DataStoreManager = require(script.Parent.DataStoreManager)
local CurrencySystem = require(script.Parent.CurrencySystem)

local DailyRewardSystem = {}

--- Get today's date string in "YYYY-MM-DD" format (UTC).
local function getTodayString(): string
	return os.date("!%Y-%m-%d")
end

--- Get yesterday's date string in "YYYY-MM-DD" format (UTC).
local function getYesterdayString(): string
	return os.date("!%Y-%m-%d", os.time() - 86400)
end

--- Check if the player can claim their daily reward.
--- @param player Player
--- @return boolean canClaim, number nextDay — whether claimable and what day they'd be claiming
function DailyRewardSystem.canClaim(player: Player): (boolean, number)
	local data = DataStoreManager.getData(player)
	if not data then
		return false, 0
	end

	local today = getTodayString()

	-- Already claimed today
	if data.lastDailyClaimDate == today then
		return false, 0
	end

	-- Determine streak
	local yesterday = getYesterdayString()
	local nextDay

	if data.lastDailyClaimDate == yesterday then
		-- Consecutive day — continue streak
		nextDay = (data.dailyStreak % #Config.DAILY_REWARDS) + 1
	else
		-- Streak broken (or first ever claim)
		if Config.DAILY_STREAK_HARD_RESET then
			nextDay = 1
		else
			nextDay = 1  -- soft reset also goes to day 1 in v1
		end
	end

	return true, nextDay
end

--- Claim the daily reward.
--- @param player Player
--- @return boolean success, table|string result — reward info or error
function DailyRewardSystem.claim(player: Player)
	local data = DataStoreManager.getData(player)
	if not data then
		return false, "Data not loaded"
	end

	local canClaim, nextDay = DailyRewardSystem.canClaim(player)
	if not canClaim then
		return false, "Already claimed today"
	end

	local today = getTodayString()
	local yesterday = getYesterdayString()

	-- Update streak
	if data.lastDailyClaimDate == yesterday then
		data.dailyStreak = data.dailyStreak + 1
	else
		data.dailyStreak = 1
	end

	data.lastDailyClaimDate = today

	-- Get reward for this day (cycle through the table)
	local rewardIndex = ((data.dailyStreak - 1) % #Config.DAILY_REWARDS) + 1
	local reward = Config.DAILY_REWARDS[rewardIndex]

	-- Award currency
	if reward.currency and reward.currency > 0 then
		CurrencySystem.addCurrency(player, reward.currency)
	end

	return true, {
		day = data.dailyStreak,
		rewardIndex = rewardIndex,
		currency = reward.currency or 0,
	}
end

return DailyRewardSystem
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">DataStoreManager</string>
            <string name="Source"><![CDATA[--[[
	DataStoreManager.luau — Handles player data persistence.
	Uses UpdateAsync with exponential backoff for reliability.
	Saves on PlayerRemoving, autosave loop, and BindToClose.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Config = require(game.ReplicatedStorage.Shared.Config)

local DataStoreManager = {}

-- In-memory cache of loaded player data, keyed by Player.UserId
local playerDataCache = {}

-- The DataStore instance
local dataStore = DataStoreService:GetDataStore(Config.DATASTORE_NAME)

--- Default data template for a new player.
local function getDefaultData()
	return {
		currency = Config.STARTING_CURRENCY,
		eggs = {},          -- array of { tier: number, id: string }
		workers = {},       -- array of { tier: number, id: string }
		eggSlotsCap = Config.EGG_SLOTS_INITIAL,
		jobSlotsCap = Config.JOB_SLOTS_INITIAL,
		luck = Config.BASE_LUCK,
		hasLuckPass = false,
		sessionStartTime = 0,           -- set at load time
		sessionRewardsClaimed = {},      -- { [1]=bool, [2]=bool }
		sessionLuckBoost = 0,            -- temporary luck boost from session reward
		dailyStreak = 0,
		lastDailyClaimDate = "",         -- "YYYY-MM-DD"
	}
end

--- Generate the DataStore key for a player.
local function getKey(player: Player): string
	return Config.DATASTORE_KEY_PREFIX .. tostring(player.UserId)
end

--- Attempt a DataStore operation with exponential backoff.
--- @param operation string — description for logging
--- @param callback function — the pcall-wrapped function to attempt
--- @return boolean, any — success, result or error
local function withRetry(operation: string, callback)
	for attempt = 1, Config.DATASTORE_MAX_RETRIES do
		local success, result = pcall(callback)
		if success then
			return true, result
		end

		warn(string.format(
			"[DataStoreManager] %s failed (attempt %d/%d): %s",
			operation, attempt, Config.DATASTORE_MAX_RETRIES, tostring(result)
		))

		if attempt < Config.DATASTORE_MAX_RETRIES then
			task.wait(2 ^ attempt)
		end
	end

	return false, "Exhausted retries for " .. operation
end

--- Load player data from DataStore (or create defaults).
--- Call this on PlayerAdded.
function DataStoreManager.loadPlayerData(player: Player)
	local key = getKey(player)

	local success, savedData = withRetry("LoadData:" .. key, function()
		return dataStore:GetAsync(key)
	end)

	local data
	if success and savedData then
		-- Merge saved data onto defaults so new fields get default values
		data = getDefaultData()
		for k, v in pairs(savedData) do
			data[k] = v
		end
	else
		data = getDefaultData()
		if not success then
			warn("[DataStoreManager] Could not load data for " .. player.Name .. ", using defaults")
		end
	end

	-- Reset session-specific fields
	data.sessionStartTime = os.clock()
	data.sessionRewardsClaimed = {}
	data.sessionLuckBoost = 0

	-- Ensure all eggs/workers have IDs (migration safety)
	for _, egg in ipairs(data.eggs) do
		if not egg.id then
			egg.id = HttpService:GenerateGUID(false)
		end
	end
	for _, worker in ipairs(data.workers) do
		if not worker.id then
			worker.id = HttpService:GenerateGUID(false)
		end
	end

	playerDataCache[player.UserId] = data
	return data
end

--- Save player data to DataStore.
function DataStoreManager.savePlayerData(player: Player)
	local data = playerDataCache[player.UserId]
	if not data then
		return
	end

	local key = getKey(player)

	-- Strip session-only fields before saving
	local toSave = {}
	for k, v in pairs(data) do
		toSave[k] = v
	end
	toSave.sessionStartTime = nil
	toSave.sessionRewardsClaimed = nil
	toSave.sessionLuckBoost = nil

	local success, err = withRetry("SaveData:" .. key, function()
		dataStore:UpdateAsync(key, function(_oldData)
			return toSave
		end)
	end)

	if not success then
		warn("[DataStoreManager] CRITICAL: Failed to save data for " .. player.Name .. ": " .. tostring(err))
	end
end

--- Get the in-memory data for a player (returns nil if not loaded).
function DataStoreManager.getData(player: Player)
	return playerDataCache[player.UserId]
end

--- Remove player from cache (call after save on PlayerRemoving).
function DataStoreManager.clearCache(player: Player)
	playerDataCache[player.UserId] = nil
end

--- Get a sanitized copy of player data safe to send to the client.
--- Omits internal fields the client shouldn't see.
function DataStoreManager.getClientData(player: Player)
	local data = playerDataCache[player.UserId]
	if not data then
		return nil
	end

	return {
		currency = data.currency,
		eggs = data.eggs,
		workers = data.workers,
		eggSlotsCap = data.eggSlotsCap,
		jobSlotsCap = data.jobSlotsCap,
		luck = data.luck,
		hasLuckPass = data.hasLuckPass,
		sessionLuckBoost = data.sessionLuckBoost,
		dailyStreak = data.dailyStreak,
		lastDailyClaimDate = data.lastDailyClaimDate,
		sessionStartTime = data.sessionStartTime,
		sessionRewardsClaimed = data.sessionRewardsClaimed,
	}
end

--- Start the autosave loop (call once from server bootstrap).
function DataStoreManager.startAutosaveLoop()
	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_INTERVAL)
			for _, player in ipairs(Players:GetPlayers()) do
				task.spawn(function()
					DataStoreManager.savePlayerData(player)
				end)
			end
		end
	end)
end

return DataStoreManager
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">HatchSystem</string>
            <string name="Source"><![CDATA[--[[
	HatchSystem.luau — Server-side egg hatching logic.
	Validates currency, rolls tier, adds egg to inventory.
]]

local HttpService = game:GetService("HttpService")

local Config = require(game.ReplicatedStorage.Shared.Config)
local RarityUtil = require(game.ReplicatedStorage.Shared.RarityUtil)
local DataStoreManager = require(script.Parent.DataStoreManager)
local LuckSystem = require(script.Parent.LuckSystem)

local HatchSystem = {}

--- Attempt to hatch a new egg for the player.
--- @param player Player
--- @return boolean success, table|string result — the new egg table or error message
function HatchSystem.hatch(player: Player)
	local data = DataStoreManager.getData(player)
	if not data then
		return false, "Data not loaded"
	end

	-- Check currency
	if data.currency < Config.HATCH_COST then
		return false, "Not enough currency"
	end

	-- Check egg inventory cap
	if #data.eggs >= data.eggSlotsCap then
		return false, "Egg inventory full"
	end

	-- Deduct cost
	data.currency = data.currency - Config.HATCH_COST

	-- Roll starting tier using player's effective luck
	local luck = LuckSystem.getEffectiveLuck(player)
	local tier = RarityUtil.rollTier(luck)

	-- Create the egg
	local newEgg = {
		tier = tier,
		id = HttpService:GenerateGUID(false),
	}

	table.insert(data.eggs, newEgg)

	return true, newEgg
end

return HatchSystem
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">JobAssignmentSystem</string>
            <string name="Source"><![CDATA[--[[
	JobAssignmentSystem.luau — Irreversible egg → worker assignment.
	Removes egg from the mergeable pool, adds it to active workers.
	The egg "hatches" into a worker and can never merge again.
]]

local DataStoreManager = require(script.Parent.DataStoreManager)

local JobAssignmentSystem = {}

--- Find an egg in the player's inventory by ID.
local function findEgg(eggs, eggId: string)
	for i, egg in ipairs(eggs) do
		if egg.id == eggId then
			return i, egg
		end
	end
	return nil, nil
end

--- Assign an egg to a job slot. Irreversible.
--- @param player Player
--- @param eggId string — ID of the egg to assign
--- @return boolean success, table|string result — the new worker or error message
function JobAssignmentSystem.assign(player: Player, eggId: string)
	local data = DataStoreManager.getData(player)
	if not data then
		return false, "Data not loaded"
	end

	-- Check job slot capacity
	if #data.workers >= data.jobSlotsCap then
		return false, "All job slots are full"
	end

	-- Find the egg
	local idx, egg = findEgg(data.eggs, eggId)
	if not egg then
		return false, "Egg not found in inventory"
	end

	-- Remove from eggs (merge pool) — irreversible
	table.remove(data.eggs, idx)

	-- Add to workers with the same tier and id
	local worker = {
		tier = egg.tier,
		id = egg.id,
	}
	table.insert(data.workers, worker)

	return true, worker
end

return JobAssignmentSystem
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">LuckSystem</string>
            <string name="Source"><![CDATA[--[[
	LuckSystem.luau — Aggregates base luck + gamepass + session boosts.
	Checks Game Pass ownership via MarketplaceService.
]]

local MarketplaceService = game:GetService("MarketplaceService")

local Config = require(game.ReplicatedStorage.Shared.Config)
local DataStoreManager = require(script.Parent.DataStoreManager)

local LuckSystem = {}

-- Cache of gamepass ownership checks (cleared on leave)
local passOwnershipCache = {}

--- Check if a player owns the 2x Luck Game Pass.
--- Caches result so we only call the API once per session.
--- @param player Player
--- @return boolean
function LuckSystem.checkLuckPass(player: Player): boolean
	if passOwnershipCache[player.UserId] ~= nil then
		return passOwnershipCache[player.UserId]
	end

	-- Skip check if the placeholder ID hasn't been replaced
	if Config.LUCK_GAMEPASS_ID == 0 then
		passOwnershipCache[player.UserId] = false
		return false
	end

	local success, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, Config.LUCK_GAMEPASS_ID)
	end)

	local result = success and owns or false
	passOwnershipCache[player.UserId] = result

	-- Also update the player data flag
	local data = DataStoreManager.getData(player)
	if data then
		data.hasLuckPass = result
	end

	return result
end

--- Called when a player purchases the luck pass mid-session.
function LuckSystem.onLuckPassPurchased(player: Player)
	passOwnershipCache[player.UserId] = true
	local data = DataStoreManager.getData(player)
	if data then
		data.hasLuckPass = true
	end
end

--- Get the player's effective luck value (base × pass × session boosts).
--- @param player Player
--- @return number — effective luck multiplier (≥ 1)
function LuckSystem.getEffectiveLuck(player: Player): number
	local data = DataStoreManager.getData(player)
	if not data then
		return Config.BASE_LUCK
	end

	local baseLuck = data.luck or Config.BASE_LUCK
	local sessionBoost = data.sessionLuckBoost or 0

	-- Apply gamepass multiplier
	if data.hasLuckPass then
		baseLuck = baseLuck * Config.LUCK_PASS_MULTIPLIER
	end

	-- Apply session luck boost (additive on top of multiplied base)
	return baseLuck + sessionBoost
end

--- Clear cache when a player leaves.
function LuckSystem.clearCache(player: Player)
	passOwnershipCache[player.UserId] = nil
end

return LuckSystem
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">MarketplaceHandler</string>
            <string name="Source"><![CDATA[--[[
	MarketplaceHandler.luau — Handles Game Pass and Developer Product purchases.
	Sets up ProcessReceipt callback and PromptGamePassPurchaseFinished listener.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Config = require(game.ReplicatedStorage.Shared.Config)
local DataStoreManager = require(script.Parent.DataStoreManager)
local CurrencySystem = require(script.Parent.CurrencySystem)
local LuckSystem = require(script.Parent.LuckSystem)
local SessionRewardSystem = require(script.Parent.SessionRewardSystem)

local MarketplaceHandler = {}

--- Initialize all marketplace listeners. Call once from server bootstrap.
function MarketplaceHandler.init()
	-- Handle Developer Product purchases (repeatable)
	MarketplaceService.ProcessReceipt = function(receiptInfo)
		local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
		if not player then
			-- Player left before receipt processed — don't grant, will retry
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		local data = DataStoreManager.getData(player)
		if not data then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		local productId = receiptInfo.ProductId

		if productId == Config.VIEWERS_PACK_PRODUCT_ID then
			-- Viewers Pack: instant currency injection
			CurrencySystem.addCurrency(player, Config.VIEWERS_PACK_AMOUNT)
			-- Sync to client
			local SyncPlayerData = game.ReplicatedStorage.Remotes:FindFirstChild("SyncPlayerData")
			if SyncPlayerData then
				SyncPlayerData:FireClient(player, DataStoreManager.getClientData(player))
			end
			return Enum.ProductPurchaseDecision.PurchaseGranted

		elseif productId == Config.INSTANT_CLAIM_PRODUCT_ID then
			-- Instant Claim: skip session timer — mark all elapsed milestones as claimable
			-- We do this by setting sessionStartTime far enough back
			local longestMilestone = 0
			for _, milestone in ipairs(Config.SESSION_MILESTONES) do
				if milestone.time > longestMilestone then
					longestMilestone = milestone.time
				end
			end
			data.sessionStartTime = os.clock() - longestMilestone - 1

			-- Sync to client
			local SyncPlayerData = game.ReplicatedStorage.Remotes:FindFirstChild("SyncPlayerData")
			if SyncPlayerData then
				SyncPlayerData:FireClient(player, DataStoreManager.getClientData(player))
			end
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end

		-- Unknown product
		warn("[MarketplaceHandler] Unknown product ID: " .. tostring(productId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Handle Game Pass purchase completion (one-time)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
		if not wasPurchased then
			return
		end

		if gamePassId == Config.LUCK_GAMEPASS_ID then
			LuckSystem.onLuckPassPurchased(player)

			-- Sync to client
			local SyncPlayerData = game.ReplicatedStorage.Remotes:FindFirstChild("SyncPlayerData")
			if SyncPlayerData then
				SyncPlayerData:FireClient(player, DataStoreManager.getClientData(player))
			end
		end
	end)
end

return MarketplaceHandler
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">MergeSystem</string>
            <string name="Source"><![CDATA[--[[
	MergeSystem.luau — Server-side merge logic.
	Always: 2x tier N → 1x tier N+1. No special-casing at rarity boundaries.
]]

local HttpService = game:GetService("HttpService")

local Config = require(game.ReplicatedStorage.Shared.Config)
local DataStoreManager = require(script.Parent.DataStoreManager)

local MergeSystem = {}

--- Find an egg in the player's inventory by ID.
--- @return number|nil index, table|nil egg
local function findEgg(eggs, eggId: string)
	for i, egg in ipairs(eggs) do
		if egg.id == eggId then
			return i, egg
		end
	end
	return nil, nil
end

--- Attempt to merge two eggs of the same tier.
--- @param player Player
--- @param eggId1 string — ID of first egg
--- @param eggId2 string — ID of second egg
--- @return boolean success, table|string result — the merged egg or error message
function MergeSystem.merge(player: Player, eggId1: string, eggId2: string)
	local data = DataStoreManager.getData(player)
	if not data then
		return false, "Data not loaded"
	end

	if eggId1 == eggId2 then
		return false, "Cannot merge an egg with itself"
	end

	local idx1, egg1 = findEgg(data.eggs, eggId1)
	local idx2, egg2 = findEgg(data.eggs, eggId2)

	if not egg1 or not egg2 then
		return false, "One or both eggs not found"
	end

	if egg1.tier ~= egg2.tier then
		return false, "Eggs must be the same tier to merge"
	end

	if egg1.tier >= Config.TIER_MAX then
		return false, "Already at maximum tier"
	end

	-- Remove both eggs (remove higher index first to avoid shifting)
	local removeFirst = math.max(idx1, idx2)
	local removeSecond = math.min(idx1, idx2)
	table.remove(data.eggs, removeFirst)
	table.remove(data.eggs, removeSecond)

	-- Create merged egg at tier + 1
	local mergedEgg = {
		tier = egg1.tier + 1,
		id = HttpService:GenerateGUID(false),
	}

	table.insert(data.eggs, mergedEgg)

	return true, mergedEgg
end

return MergeSystem
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">SessionRewardSystem</string>
            <string name="Source"><![CDATA[--[[
	SessionRewardSystem.luau — Server-authoritative session timer rewards.
	Timer resets when the player leaves. Milestones require manual claim.
]]

local HttpService = game:GetService("HttpService")

local Config = require(game.ReplicatedStorage.Shared.Config)
local RarityUtil = require(game.ReplicatedStorage.Shared.RarityUtil)
local DataStoreManager = require(script.Parent.DataStoreManager)
local CurrencySystem = require(script.Parent.CurrencySystem)
local LuckSystem = require(script.Parent.LuckSystem)

local SessionRewardSystem = {}

--- Check which milestones the player is eligible for but hasn't claimed yet.
--- @param player Player
--- @return { number } — array of milestone indices (1-based) that are claimable
function SessionRewardSystem.getClaimableMilestones(player: Player): { number }
	local data = DataStoreManager.getData(player)
	if not data then
		return {}
	end

	local elapsed = os.clock() - data.sessionStartTime
	local claimable = {}

	for i, milestone in ipairs(Config.SESSION_MILESTONES) do
		local alreadyClaimed = data.sessionRewardsClaimed[i]
		if elapsed >= milestone.time and not alreadyClaimed then
			table.insert(claimable, i)
		end
	end

	return claimable
end

--- Claim a specific session reward milestone.
--- @param player Player
--- @param milestoneIndex number — 1-based index into SESSION_MILESTONES
--- @return boolean success, string result
function SessionRewardSystem.claim(player: Player, milestoneIndex: number)
	local data = DataStoreManager.getData(player)
	if not data then
		return false, "Data not loaded"
	end

	local milestone = Config.SESSION_MILESTONES[milestoneIndex]
	if not milestone then
		return false, "Invalid milestone index"
	end

	-- Check eligibility
	local elapsed = os.clock() - data.sessionStartTime
	if elapsed < milestone.time then
		return false, "Milestone not yet reached"
	end

	if data.sessionRewardsClaimed[milestoneIndex] then
		return false, "Already claimed"
	end

	-- Mark as claimed
	data.sessionRewardsClaimed[milestoneIndex] = true

	-- Award currency
	if milestone.currency and milestone.currency > 0 then
		CurrencySystem.addCurrency(player, milestone.currency)
	end

	-- Apply session luck boost
	if milestone.luckBoost and milestone.luckBoost > 0 then
		data.sessionLuckBoost = (data.sessionLuckBoost or 0) + milestone.luckBoost
	end

	-- Award free egg at elevated minimum tier
	if milestone.freeEgg then
		local luck = LuckSystem.getEffectiveLuck(player)
		local tier = RarityUtil.rollTierWithFloor(luck, milestone.freeEggMinTier or 0)
		local newEgg = {
			tier = tier,
			id = HttpService:GenerateGUID(false),
		}
		-- Add to eggs if there's room, otherwise just give currency equivalent
		if #data.eggs < data.eggSlotsCap then
			table.insert(data.eggs, newEgg)
		else
			-- Fallback: give sell value instead if inventory is full
			local sellValue = Config.SELL_EGG_VALUE_PER_TIER[tier] or 0
			CurrencySystem.addCurrency(player, sellValue)
		end
	end

	return true, "Claimed milestone " .. tostring(milestoneIndex)
end

return SessionRewardSystem
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">SlotSystem</string>
            <string name="Source"><![CDATA[--[[
	SlotSystem.luau — Egg inventory cap and job slot cap expansion.
	Cost escalates per additional slot purchased.
]]

local Config = require(game.ReplicatedStorage.Shared.Config)
local DataStoreManager = require(script.Parent.DataStoreManager)

local SlotSystem = {}

--- Calculate the cost of the next slot expansion.
--- Formula: BASE_COST * SCALE ^ (currentCap - initialCap)
local function calculateCost(baseCost: number, costScale: number, currentCap: number, initialCap: number): number
	local slotsBought = currentCap - initialCap
	return math.floor(baseCost * (costScale ^ slotsBought))
end

--- Get the cost of the next egg slot expansion.
function SlotSystem.getEggSlotCost(player: Player): number
	local data = DataStoreManager.getData(player)
	if not data then
		return math.huge
	end
	return calculateCost(
		Config.EGG_SLOT_BASE_COST,
		Config.EGG_SLOT_COST_SCALE,
		data.eggSlotsCap,
		Config.EGG_SLOTS_INITIAL
	)
end

--- Get the cost of the next job slot expansion.
function SlotSystem.getJobSlotCost(player: Player): number
	local data = DataStoreManager.getData(player)
	if not data then
		return math.huge
	end
	return calculateCost(
		Config.JOB_SLOT_BASE_COST,
		Config.JOB_SLOT_COST_SCALE,
		data.jobSlotsCap,
		Config.JOB_SLOTS_INITIAL
	)
end

--- Buy a slot expansion.
--- @param player Player
--- @param slotType string — "egg" or "job"
--- @return boolean success, string result — "ok" or error message
function SlotSystem.buySlot(player: Player, slotType: string)
	local data = DataStoreManager.getData(player)
	if not data then
		return false, "Data not loaded"
	end

	if slotType == "egg" then
		if data.eggSlotsCap >= Config.EGG_SLOTS_MAX then
			return false, "Already at maximum egg slots"
		end

		local cost = SlotSystem.getEggSlotCost(player)
		if data.currency < cost then
			return false, "Not enough currency"
		end

		data.currency = data.currency - cost
		data.eggSlotsCap = data.eggSlotsCap + 1
		return true, "ok"

	elseif slotType == "job" then
		if data.jobSlotsCap >= Config.JOB_SLOTS_MAX then
			return false, "Already at maximum job slots"
		end

		local cost = SlotSystem.getJobSlotCost(player)
		if data.currency < cost then
			return false, "Not enough currency"
		end

		data.currency = data.currency - cost
		data.jobSlotsCap = data.jobSlotsCap + 1
		return true, "ok"

	else
		return false, "Invalid slot type: " .. tostring(slotType)
	end
end

return SlotSystem
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
